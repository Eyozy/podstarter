---
import MainLayout from "../layouts/MainLayout.astro";
import EpisodeCard from "../components/EpisodeCard.astro";
import { publishedEpisodes, episodeYear } from "../utils/episodes";
import themes from "../data/themes.json";
import { loadSiteConfig } from "../../scripts/siteConfig.js";
const site = loadSiteConfig();

const aiEnabled = site.features?.aiTagging === true;
const years = [
  ...new Set(publishedEpisodes.map((ep) => episodeYear(ep.pubDate))),
].sort((a, b) => b - a);

const allTags = aiEnabled
  ? [...new Set(publishedEpisodes.flatMap((ep) => ep.tags || []))].sort()
  : [];
---

<MainLayout title={site.pages.episodes.title}>
  <div class="mb-8 md:mb-12 lg:mb-20 max-w-4xl">
    <p class="text-[10px] md:text-[11px] font-serif font-bold uppercase tracking-[0.24em] text-orange-800/60 mb-3">
      Episodes
    </p>
    <h1
      class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-[#2d2a26] mb-4 md:mb-6"
    >
      {site.pages.episodes.headline}
    </h1>
    <p
      class="text-base md:text-lg opacity-60 font-serif leading-relaxed max-w-3xl"
    >
      {site.pages.episodes.description}
    </p>
  </div>

  <div class="flex flex-col lg:flex-row gap-6 md:gap-8 lg:gap-12 items-stretch lg:items-start">
    {publishedEpisodes.length > 0 && (
    <aside
      class="w-full lg:w-64 xl:w-72 shrink-0 space-y-5 md:space-y-7 lg:space-y-10 z-10 lg:sticky lg:top-24"
    >
      <div
        id="active-theme-section"
        class="hidden bg-orange-50 p-4 sm:p-5 border border-orange-100 rounded-2xl relative group transition-all duration-300"
      >
        <h3
          class="text-[10px] font-serif font-bold uppercase tracking-[0.2em] text-orange-800/60 mb-3 flex items-center gap-2"
        >
          <span class="w-4 h-px bg-orange-800/20"></span>
          {site.pages.episodes.activeThemeLabel}
        </h3>
        <div class="flex items-center justify-between">
          <h4 id="active-theme-title" class="text-lg font-bold text-[#2d2a26]">
          </h4>
          <button
            id="clear-theme-btn"
            class="text-orange-800/40 hover:text-orange-800 hover:bg-orange-800/5 p-2 rounded-full transition-all"
            title={site.pages.episodes.clearThemeTitle}
          >
            <i class="ri-close-line text-base sm:text-lg"></i>
          </button>
        </div>
      </div>

      <div
        class="bg-white/50 lg:bg-transparent p-4 md:p-5 lg:p-0 border border-[#2d2a26]/5 lg:border-none rounded-2xl shadow-sm lg:shadow-none backdrop-blur-md lg:backdrop-blur-none"
      >
        <h3
          class="text-[10px] font-serif font-bold uppercase tracking-[0.2em] text-orange-800/60 mb-4 md:mb-6 flex items-center gap-2"
        >
          <span class="w-4 h-px bg-orange-800/20"></span>
          {site.pages.episodes.searchLabel}
        </h3>
        <div class="relative group">
          <input
            type="text"
            id="search-input"
            placeholder={site.pages.episodes.searchPlaceholder}
            class="w-full px-4 md:px-5 py-3 md:py-4 bg-white border-2 border-[#2d2a26]/10 focus:border-orange-800/60 rounded-xl font-serif text-sm focus:outline-none focus:ring-4 focus:ring-orange-800/10 transition-all shadow-sm pr-10 md:pr-12 placeholder-[#2d2a26]/40 group-hover:border-[#2d2a26]/30"
          />
          <div
            class="absolute right-0 top-0 bottom-0 flex items-center pr-3 md:pr-4"
          >
            <button
              id="search-clear-btn"
              class="text-[#2d2a26] opacity-20 hover:opacity-100 transition-opacity hidden"
              title={site.pages.episodes.searchClearTitle}
            >
              <i class="ri-close-line text-base sm:text-lg"></i>
            </button>
            <div
              id="search-icon"
              class="text-[#2d2a26] opacity-20 group-focus-within:opacity-100 transition-opacity pointer-events-none"
            >
              <i class="ri-search-line text-base sm:text-lg"></i>
            </div>
          </div>
        </div>
        <p
          id="search-count"
          class="mt-3 md:mt-4 text-[10px] font-serif opacity-40 italic hidden items-center gap-2 px-1"
        >
          <i class="ri-information-line text-xs"></i>
          {site.pages.episodes.searchCountPrefix}{" "}
          <span id="count-num" class="font-bold">0</span>{" "}
          {site.pages.episodes.searchCountSuffix}
        </p>
      </div>

      <div
        class="bg-white/50 lg:bg-transparent p-4 md:p-5 lg:p-0 border border-[#2d2a26]/5 lg:border-none rounded-2xl shadow-sm lg:shadow-none backdrop-blur-md lg:backdrop-blur-none lg:pt-8 lg:border-t lg:border-[#2d2a26]/5"
      >
        <h3
          class="text-[10px] font-serif font-bold uppercase tracking-[0.2em] text-orange-800/60 mb-4 md:mb-6 flex items-center gap-2"
        >
          <span class="w-4 h-px bg-orange-800/20"></span>
          {site.pages.episodes.yearFilterTitle}
        </h3>
        <div class="flex flex-wrap gap-2">
          <button
            class="year-filter px-3 md:px-5 py-2 md:py-2.5 text-xs font-serif font-bold bg-[#2d2a26] text-white rounded-lg transition-all shadow-sm active:scale-95"
            data-year="all"
          >
            {site.pages.episodes.allYearsLabel}
          </button>
          {
            years.map((year) => (
              <button
                class="year-filter px-3 md:px-5 py-2 md:py-2.5 text-xs font-serif font-bold border border-[#2d2a26]/10 bg-white/80 text-[#2d2a26] hover:bg-white hover:border-[#2d2a26] transition-all rounded-lg shadow-sm active:scale-95"
                data-year={year}
              >
                {year}
              </button>
            ))
          }
        </div>
      </div>

      {/* 按标签筛选 - 仅在 AI 功能开启时显示 */}
      {aiEnabled && (
      <div
        class="bg-white/50 lg:bg-transparent p-4 md:p-5 lg:p-0 border border-[#2d2a26]/5 lg:border-none rounded-2xl shadow-sm lg:shadow-none backdrop-blur-md lg:backdrop-blur-none lg:pt-8 lg:border-t lg:border-[#2d2a26]/5"
      >
        <h3
          class="text-[10px] font-serif font-bold uppercase tracking-[0.2em] text-orange-800/60 mb-4 md:mb-6 flex items-center justify-between"
        >
          <span class="flex items-center gap-2">
            <span class="w-4 h-px bg-orange-800/20"></span>
            {site.pages.episodes.tagFilterTitle}
          </span>
          <button
            id="clear-tag-btn"
            class="hidden text-[10px] font-normal normal-case tracking-normal text-orange-800/60 hover:text-orange-800 transition-colors underline"
          >
            {site.pages.episodes.clearTagLabel}
          </button>
        </h3>
        <div id="tag-filters">
          <div class="flex flex-wrap gap-2" id="tag-list">
            {
              allTags.map((tag, index) => (
                <button
                  class:list={[
                    "tag-filter px-3 py-1.5 text-xs font-serif border border-[#2d2a26]/10 bg-white/80 text-[#2d2a26] hover:bg-white hover:border-[#2d2a26] transition-all rounded-lg shadow-sm active:scale-95",
                    index >= 12
                      ? "tag-extra hidden opacity-0 translate-y-1 pointer-events-none transition-all duration-300 ease-out"
                      : "",
                  ]}
                  data-tag={tag}
                >
                  {tag}
                </button>
              ))
            }
          </div>
          {allTags.length > 12 && (
            <button
              id="toggle-tags-btn"
              class="mt-3 text-[10px] font-serif text-orange-800/60 hover:text-orange-800 transition-colors flex items-center gap-1"
            >
              <span id="toggle-tags-text">{site.pages.episodes.toggleTagsExpandLabel}</span>
              <i id="toggle-tags-icon" class="ri-arrow-down-s-line text-sm transition-transform"></i>
            </button>
          )}
        </div>
      </div>
      )}
    </aside>
    )}

    <div
      class="flex-1 min-w-0 space-y-4 md:space-y-6 lg:space-y-8 w-full"
      id="episodes-container"
    >
      {
        publishedEpisodes.map((episode) => (
          <div
            class="episode-item"
            data-id={episode.id}
            data-year={episodeYear(episode.pubDate)}
            data-theme={episode.themeId}
            data-tags={JSON.stringify(episode.tags || [])}
            data-title={episode.title.toLowerCase()}
            data-snippet={episode.contentSnippet.toLowerCase()}
          >
            <EpisodeCard episode={episode} />
          </div>
        ))
      }
      {publishedEpisodes.length === 0 ? (
        <div class="py-16 sm:py-24 text-center border border-dashed border-[#2d2a26]/15 rounded-2xl bg-white/40 p-6 sm:p-10 w-full">
          <div class="size-12 rounded-full bg-orange-50 border border-orange-200 text-orange-800 flex items-center justify-center mx-auto mb-4">
            <i class="ri-mic-line text-2xl"></i>
          </div>
          <h3 class="text-lg font-bold text-[#2d2a26] mb-1">暂无已发布节目</h3>
          <p class="text-xs sm:text-sm text-[#2d2a26]/60 font-serif leading-relaxed max-w-sm mx-auto mb-6">
            欢迎使用 PodStarter！你可以前往管理控制台直接粘贴 RSS 地址一键同步，快速导入你的第一期播客。
          </p>
          <a
            href="/admin"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#2d2a26] text-white text-xs font-mono font-bold hover:bg-orange-800 transition-colors shadow-sm"
          >
            <i class="ri-settings-3-line text-sm"></i>
            <span>前往管理控制台一键导入</span>
          </a>
        </div>
      ) : (
        <div
          id="no-results"
          class="hidden py-20 sm:py-24 md:py-32 text-center border-2 border-dashed border-[#2d2a26]/5 rounded-2xl bg-white/20 px-6"
        >
          <p class="text-xl opacity-40 font-serif italic mb-2">
            {site.pages.episodes.emptyTitle}
          </p>
          <p class="text-sm opacity-30 font-serif">
            {site.pages.episodes.emptySubtitle}
          </p>
        </div>
      )}
    </div>
  </div>
</MainLayout>

<script is:inline define:vars={{ themes }}>
  window.themesData = themes;
</script>

<script is:inline define:vars={{ toggleTagsExpandLabel: site.pages.episodes.toggleTagsExpandLabel, toggleTagsCollapseLabel: site.pages.episodes.toggleTagsCollapseLabel, pagefindBaseUrl: `${Astro.site?.pathname || "/"}pagefind/pagefind.js`, pagefindEnabled: !import.meta.env.DEV }}>
  function initSearch() {
    const container = document.getElementById("episodes-container");
    if (!(container instanceof HTMLElement)) return;
    if (container.dataset.searchBound === "true") return;
    container.dataset.searchBound = "true";

    const searchInput = document.getElementById("search-input");
    const searchInputEl =
      searchInput instanceof HTMLInputElement ? searchInput : null;
    const filterButtons = document.querySelectorAll(".year-filter");
    const episodeItems = document.querySelectorAll(".episode-item");
    const noResults = document.getElementById("no-results");
    const searchCount = document.getElementById("search-count");
    const countNum = document.getElementById("count-num");
    const clearBtn = document.getElementById("search-clear-btn");
    const searchIcon = document.getElementById("search-icon");

    const activeThemeSection = document.getElementById("active-theme-section");
    const activeThemeTitle = document.getElementById("active-theme-title");
    const clearThemeBtn = document.getElementById("clear-theme-btn");

    const tagButtons = document.querySelectorAll(".tag-filter");
    const clearTagBtn = document.getElementById("clear-tag-btn");
    const toggleTagsBtn = document.getElementById("toggle-tags-btn");
    const toggleTagsText = document.getElementById("toggle-tags-text");
    const toggleTagsIcon = document.getElementById("toggle-tags-icon");
    const extraTags = document.querySelectorAll(".tag-extra");
    const state = {
      currentYear: "all",
      currentTheme: "all",
      currentTag: "all",
      currentQuery: "",
      tagsExpanded: false,
    };

    const originalContent = new Map();
    episodeItems.forEach((item) => {
      if (!(item instanceof HTMLElement)) return;
      const id = item.getAttribute("data-id");
      if (!id) return;
      
      const snippetEl = item.querySelector(`[data-episode-snippet="${id}"]`);
      const titleLinkEl = item.querySelector(`[data-card-title-link="${id}"]`);
      originalContent.set(id, {
        snippetHTML: snippetEl ? snippetEl.innerHTML : "",
        titleHTML: titleLinkEl ? titleLinkEl.innerHTML : "",
        snippetClass: snippetEl ? snippetEl.className : "",
      });
    });

    let pagefind = null;
    const loadPagefind = async () => {
      if (!pagefindEnabled) {
        return;
      }
      if (window.pagefind) {
        pagefind = window.pagefind;
        return;
      }

      const pagefindBase = pagefindBaseUrl;
      try {
        const pf = await import(/* @vite-ignore */ pagefindBase);
        await pf.options({});
        pagefind = pf;
        window.pagefind = pf;
      } catch (e) {
        console.warn("未检测到 Pagefind 静态索引，降级使用原生字符匹配检索:", e);
      }
    };
    loadPagefind();

    const activeClasses = ["bg-[#2d2a26]", "text-white", "hover:text-white"];
    const inactiveClasses = [
      "border",
      "border-[#2d2a26]/10",
      "bg-white/80",
      "text-[#2d2a26]",
      "hover:bg-white",
      "hover:border-[#2d2a26]",
    ];

    const tagActiveClasses = [
      "bg-[#2d2a26]",
      "text-white",
      "hover:text-white",
      "hover:bg-[#2d2a26]",
      "border-[#2d2a26]",
    ];
    const tagInactiveClasses = [
      "border-[#2d2a26]/10",
      "bg-white/80",
      "text-[#2d2a26]",
      "hover:bg-white",
      "hover:border-[#2d2a26]",
    ];

    const updateTagUI = () => {
      if (state.currentTag !== "all") {
        clearTagBtn?.classList.remove("hidden");
      } else {
        clearTagBtn?.classList.add("hidden");
      }
    };

    const updateSearchUI = () => {
      if (state.currentQuery !== "") {
        clearBtn?.classList.remove("hidden");
        searchIcon?.classList.add("hidden");
      } else {
        clearBtn?.classList.add("hidden");
        searchIcon?.classList.remove("hidden");
      }
    };

    const updateThemeUI = () => {
      const themesData = Array.isArray(window.themesData)
        ? window.themesData
        : [];
      if (state.currentTheme !== "all" && themesData.length) {
        const theme = themesData.find((t) => t.id === state.currentTheme);
        if (theme) {
          if (activeThemeSection) activeThemeSection.classList.remove("hidden");
          if (activeThemeTitle) activeThemeTitle.textContent = theme.title;
        } else {
          if (activeThemeSection) activeThemeSection.classList.add("hidden");
        }
      } else {
        if (activeThemeSection) activeThemeSection.classList.add("hidden");
      }
    };

    const highlightRawText = (text, keyword) => {
      if (!keyword) return text;
      const escapedKeyword = keyword.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      const regex = new RegExp(`(${escapedKeyword})`, "gi");
      return text.replace(regex, "<mark>$1</mark>");
    };

    const buildManualExcerpt = (
      text,
      query,
      contextBefore = 20,
      contextAfter = 40,
    ) => {
      const lowerText = text.toLowerCase();
      const lowerQuery = query.toLowerCase();
      const queryIndex = lowerText.indexOf(lowerQuery);

      if (queryIndex < 0) return highlightRawText(text, query);

      const start = Math.max(0, queryIndex - contextBefore);
      const end = Math.min(text.length, queryIndex + query.length + contextAfter);
      let excerpt = text.slice(start, end);

      if (start > 0) excerpt = `...${excerpt}`;
      if (end < text.length) excerpt = `${excerpt}...`;

      return highlightRawText(excerpt, query);
    };

    const getSearchPresentation = ({
      query,
      title = "",
      snippetText = "",
      excerptHtml = "",
      visibleThreshold = 60,
    }) => {
      if (!query) {
        return {
          snippetHtml: snippetText,
          titleHtml: title,
        };
      }

      const lowerQuery = query.toLowerCase();
      const lowerTitle = title.toLowerCase();
      const lowerSnippet = snippetText.toLowerCase();
      const queryIndex = lowerSnippet.indexOf(lowerQuery);
      const titleHtml = highlightRawText(title, query);

      if (!excerptHtml) {
        if (queryIndex >= visibleThreshold) {
          return {
            snippetHtml: `<span class="transcript-badge">节目介绍</span>${buildManualExcerpt(snippetText, query)}`,
            titleHtml,
          };
        }

        return {
          snippetHtml: highlightRawText(snippetText, query),
          titleHtml,
        };
      }

      if (!lowerTitle.includes(lowerQuery) && !lowerSnippet.includes(lowerQuery)) {
        return {
          snippetHtml: `<span class="transcript-badge">文字稿</span>${excerptHtml}`,
          titleHtml,
        };
      }

      if (queryIndex >= visibleThreshold) {
        return {
          snippetHtml: `<span class="transcript-badge">节目介绍</span>${excerptHtml}`,
          titleHtml,
        };
      }

      return {
        snippetHtml: highlightRawText(snippetText, query),
        titleHtml,
      };
    };

    const fallbackIncludesSearch = (query, matchedIds) => {
      episodeItems.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        const id = item.getAttribute("data-id") || "";
        const title = item.getAttribute("data-title") || "";
        const snippet = item.getAttribute("data-snippet") || "";
        if (title.includes(query) || snippet.includes(query)) {
          matchedIds.add(id);
        }
      });
    };

    let currentSearchId = 0;

    const filterEpisodes = async () => {
      const searchId = ++currentSearchId;
      const query = state.currentQuery;
      let visibleCount = 0;
      let matchedIds = new Set();
      let excerpts = new Map();

      if (query !== "" && pagefind) {
        try {
          const search = await pagefind.search(query);
          if (searchId !== currentSearchId) return;

          const results = await Promise.all(search.results.map((r) => r.data()));
          if (searchId !== currentSearchId) return;

          results.forEach((res) => {
            const urlMatch = res.url.match(/\/episodes\/([^\/]+)/);
            if (urlMatch) {
              const id = urlMatch[1];
              matchedIds.add(id);
              excerpts.set(id, res.excerpt);
            }
          });
        } catch (err) {
          console.error("Pagefind 检索失败，降级使用原生包括匹配:", err);
          fallbackIncludesSearch(query, matchedIds);
        }
      } else if (query !== "") {
        fallbackIncludesSearch(query, matchedIds);
      }

      if (searchId !== currentSearchId) return;

      episodeItems.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        const id = item.getAttribute("data-id") || "";
        const year = item.getAttribute("data-year");
        const theme = item.getAttribute("data-theme");
        const tags = JSON.parse(item.getAttribute("data-tags") || "[]");

        const yearMatch =
          state.currentYear === "all" || year === state.currentYear;
        const themeMatch =
          state.currentTheme === "all" || theme === state.currentTheme;
        const tagMatch =
          state.currentTag === "all" || tags.includes(state.currentTag);

        let queryMatch = true;
        if (query !== "") {
          queryMatch = matchedIds.has(id);
        }

        if (yearMatch && themeMatch && tagMatch && queryMatch) {
          item.style.display = "block";
          visibleCount++;

          const original = originalContent.get(id);
          const snippetEl = item.querySelector(`[data-episode-snippet="${id}"]`);
          const titleLinkEl = item.querySelector(`[data-card-title-link="${id}"]`);

          if (query !== "" && original) {
            const presentation = getSearchPresentation({
              query,
              title: titleLinkEl?.textContent || "",
              snippetText: snippetEl?.textContent || "",
              excerptHtml: excerpts.get(id) || "",
            });

            if (snippetEl) {
              snippetEl.innerHTML = presentation.snippetHtml;
            }
            if (titleLinkEl) {
              titleLinkEl.innerHTML = presentation.titleHtml;
            }
          } else if (original) {
            if (snippetEl) {
              snippetEl.innerHTML = original.snippetHTML;
            }
            if (titleLinkEl) titleLinkEl.innerHTML = original.titleHTML;
          }

        } else {
          item.style.display = "none";
          const original = originalContent.get(id);
          const snippetEl = item.querySelector(`[data-episode-snippet="${id}"]`);
          const titleLinkEl = item.querySelector(`[data-card-title-link="${id}"]`);
          if (original) {
            if (snippetEl) {
              snippetEl.innerHTML = original.snippetHTML;
            }
            if (titleLinkEl) titleLinkEl.innerHTML = original.titleHTML;
          }
        }
      });

      if (query !== "") {
        searchCount?.classList.remove("hidden");
        searchCount?.classList.add("flex");
        if (countNum) countNum.textContent = visibleCount.toString();
      } else {
        searchCount?.classList.add("hidden");
        searchCount?.classList.remove("flex");
      }

      if (query !== "" && visibleCount === 0) {
        noResults?.classList.remove("hidden");
      } else {
        noResults?.classList.add("hidden");
      }
    };

    const updateYearButtons = (activeButton) => {
      filterButtons.forEach((btn) => {
        btn.classList.remove(...activeClasses);
        btn.classList.add(...inactiveClasses);
      });
      activeButton.classList.remove(...inactiveClasses);
      activeButton.classList.add(...activeClasses);
    };

    const clearTagSelection = () => {
      state.currentTag = "all";
      tagButtons.forEach((btn) => {
        btn.classList.remove(...tagActiveClasses);
        btn.classList.add(...tagInactiveClasses);
      });
      updateTagUI();
    };

    searchInputEl?.addEventListener("input", () => {
      state.currentQuery = searchInputEl.value.toLowerCase().trim();
      updateSearchUI();
      filterEpisodes();
    });

    clearBtn?.addEventListener("click", () => {
      if (searchInputEl) {
        searchInputEl.value = "";
        state.currentQuery = "";
        updateSearchUI();
        filterEpisodes();
        searchInputEl.focus();
      }
    });

    clearThemeBtn?.addEventListener("click", () => {
      state.currentTheme = "all";

      const newUrl = new URL(window.location.href);
      newUrl.searchParams.delete("theme");
      window.history.pushState({}, "", newUrl);

      updateThemeUI();
      filterEpisodes();
    });

    tagButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const tag = button.getAttribute("data-tag");

        if (state.currentTag === tag) {
          state.currentTag = "all";
          button.classList.remove(...tagActiveClasses);
          button.classList.add(...tagInactiveClasses);
        } else {
          state.currentTag = tag || "all";

          tagButtons.forEach((btn) => {
            btn.classList.remove(...tagActiveClasses);
            btn.classList.add(...tagInactiveClasses);
          });
          button.classList.add(...tagActiveClasses);
          button.classList.remove(...tagInactiveClasses);
        }

        updateTagUI();
        filterEpisodes();
      });
    });

    clearTagBtn?.addEventListener("click", () => {
      clearTagSelection();
      filterEpisodes();
    });

    toggleTagsBtn?.addEventListener("click", () => {
      state.tagsExpanded = !state.tagsExpanded;

      if (state.tagsExpanded) {
        extraTags.forEach((tag) => {
          tag.classList.remove("hidden");
          requestAnimationFrame(() => {
            tag.classList.remove(
              "opacity-0",
              "translate-y-1",
              "pointer-events-none",
            );
            tag.classList.add("opacity-100", "translate-y-0");
          });
        });
        if (toggleTagsText) toggleTagsText.textContent = toggleTagsCollapseLabel;
        toggleTagsIcon?.classList.add("rotate-180");
      } else {
        extraTags.forEach((tag) => {
          tag.classList.add(
            "opacity-0",
            "translate-y-1",
            "pointer-events-none",
          );
          tag.classList.remove("opacity-100", "translate-y-0");
        });
        if (toggleTagsText) toggleTagsText.textContent = toggleTagsExpandLabel;
        toggleTagsIcon?.classList.remove("rotate-180");
        window.setTimeout(() => {
          extraTags.forEach((tag) => {
            if (tag.classList.contains("opacity-0")) {
              tag.classList.add("hidden");
            }
          });
        }, 300);
      }
    });

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const year = button.getAttribute("data-year");
        state.currentYear = year || "all";

        updateYearButtons(button);
        filterEpisodes();
      });
    });

    const urlParams = new URLSearchParams(window.location.search);

    const themeParam = urlParams.get("theme");
    if (themeParam) {
      state.currentTheme = themeParam;
      updateThemeUI();
    }

    const searchQuery = urlParams.get("search");
    if (searchQuery) {
      state.currentQuery = searchQuery.toLowerCase().trim();
      if (searchInputEl) {
        searchInputEl.value = searchQuery;
      }
      updateSearchUI();
      filterEpisodes();
    }

    filterEpisodes();
  }

  const scheduleSearchInit = () => {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSearch, { once: true });
      return;
    }
    initSearch();
  };

  scheduleSearchInit();
  document.addEventListener("astro:page-load", initSearch);
</script>
