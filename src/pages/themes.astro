---
import MainLayout from "../layouts/MainLayout.astro";
import EpisodeCard from "../components/EpisodeCard.astro";
import type { Theme } from "../types";
import { publishedEpisodes } from "../utils/episodes";
import themesData from "../data/themes.json";
import { loadSiteConfig } from "../../scripts/siteConfig.js";
const site = loadSiteConfig();


const themesEnabled = site.features?.themes === true;
if (!themesEnabled) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const themes = themesData as Theme[];

const themesWithCount = themes.map((theme) => ({
  ...theme,
  count: publishedEpisodes.filter((ep) => ep.themeId === theme.id).length,
}));
---

<MainLayout title={site.pages.themes.title}>
  <div class="max-w-7xl mx-auto">
    <div class="mb-8 sm:mb-10 md:mb-12">
      <p class="text-[10px] md:text-[11px] font-serif font-bold uppercase tracking-[0.24em] text-orange-800/60 mb-3">
        Themes
      </p>
      <h1
        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-[#2d2a26] mb-4 md:mb-6"
      >
        {site.pages.themes.headline}
      </h1>
    </div>

    {themesWithCount.length === 0 ? (
      <div class="py-16 text-center border border-dashed border-[#2d2a26]/15 rounded-2xl bg-white/40 p-8 sm:p-12 mb-12 max-w-xl mx-auto">
        <div class="size-12 rounded-2xl bg-orange-50 border border-orange-200/80 text-orange-800 flex items-center justify-center mx-auto mb-4">
          <i class="ri-sparkling-line text-xl"></i>
        </div>
        <h3 class="text-base font-bold text-[#2d2a26] mb-1.5 font-serif">暂无主题分类</h3>
        <p class="text-xs text-[#2d2a26]/60 font-serif leading-relaxed mb-6">
          可直接在终端执行 <code class="px-1.5 py-0.5 rounded bg-black/5 font-mono text-[11px] text-[#2d2a26] font-bold">npm run analyze</code> 智能聚类生成主题，或前往管理后台查看完整打标工作流。
        </p>
        <a
          href="/admin#config"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#2d2a26] text-white text-xs font-mono font-bold hover:bg-orange-800 transition-colors shadow-sm"
        >
          前往管理后台查看指引 ↗
        </a>
      </div>
    ) : (
      <div
        class="flex flex-wrap gap-2.5 sm:gap-3 mb-8 sm:mb-10 md:mb-12"
        data-theme-tabs-root
      >
        {
          themesWithCount.map((theme, index) => (
            <button
              class:list={[
                "theme-tab px-3.5 py-2 sm:px-4 md:px-6 md:py-3 rounded-full font-serif text-sm md:text-base transition-all duration-300 border shadow-sm",
                index === 0
                  ? "bg-[#2d2a26] text-white border-[#2d2a26] hover:bg-[#2d2a26] hover:text-white shadow-[0_10px_20px_-16px_rgba(0,0,0,0.45)]"
                  : "bg-white text-[#2d2a26] border-[#2d2a26]/10 hover:text-[#2d2a26] hover:border-[#2d2a26]/30 hover:bg-white/90",
              ]}
              data-theme-id={theme.id}
            >
              {theme.title}
              <span class="ml-1.5 text-xs opacity-60">({theme.count})</span>
            </button>
          ))
        }
      </div>
    )}

    <div class="mb-8 sm:mb-10">
      {
        themes.map((theme, index) => (
          <div
            class:list={[
              "theme-description transition-all duration-300 py-1",
              index === 0 ? "block" : "hidden",
            ]}
            data-theme-desc={theme.id}
          >
            <p class="text-base sm:text-lg font-serif opacity-60 leading-relaxed mb-4 max-w-none">
              {theme.description}
            </p>
            {theme.representativeTags &&
              theme.representativeTags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {theme.representativeTags.map((tag) => (
                    <span class="text-xs font-serif px-3 py-1 bg-[#2d2a26]/5 text-[#2d2a26]/60 rounded-full border border-[#2d2a26]/5">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
          </div>
        ))
      }
    </div>

    {
      themes.map((theme, index) => {
        const themeEpisodes = publishedEpisodes.filter((ep) => ep.themeId === theme.id);

        return (
          <div
            class:list={[
              "theme-episodes transition-all duration-300",
              index === 0 ? "block" : "hidden",
            ]}
            data-theme-list={theme.id}
          >
            {themeEpisodes.length > 0 ? (
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                {themeEpisodes.map((episode) => (
                  <EpisodeCard episode={episode} compact={true} />
                ))}
              </div>
            ) : (
              <div class="bg-white/50 border border-[#2d2a26]/5 border-dashed rounded-xl p-8 sm:p-10 md:p-12 text-center">
                <p class="text-lg opacity-40 font-serif">{site.pages.themes.emptyLabel}</p>
              </div>
            )}
          </div>
        );
      })
    }
  </div>
</MainLayout>

<script>
  function initThemeTabs() {
    const tabsRoot = document.querySelector("[data-theme-tabs-root]");
    if (!(tabsRoot instanceof HTMLElement)) return;
    if (tabsRoot.dataset.bound === "true") return;
    tabsRoot.dataset.bound = "true";

    const tabs = document.querySelectorAll(".theme-tab");
    const descriptions = document.querySelectorAll(".theme-description");
    const episodeLists = document.querySelectorAll(".theme-episodes");

    const ACTIVE_TAB = [
      "bg-[#2d2a26]",
      "text-white",
      "border-[#2d2a26]",
      "hover:bg-[#2d2a26]",
      "hover:text-white",
      "shadow-[0_10px_20px_-16px_rgba(0,0,0,0.45)]",
    ];
    const INACTIVE_TAB = [
      "bg-white",
      "text-[#2d2a26]",
      "border-[#2d2a26]/10",
      "hover:text-[#2d2a26]",
      "hover:border-[#2d2a26]/30",
      "hover:bg-white/90",
    ];

    function showByAttribute(
      elements: NodeListOf<Element>,
      attrName: string,
      targetValue: string | null,
    ) {
      elements.forEach((el) => {
        const isMatch = el.getAttribute(attrName) === targetValue;
        el.classList.toggle("hidden", !isMatch);
        el.classList.toggle("block", isMatch);
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const themeId = tab.getAttribute("data-theme-id");

        tabs.forEach((t) => {
          t.classList.remove(...ACTIVE_TAB);
          t.classList.add(...INACTIVE_TAB);
        });
        tab.classList.remove(...INACTIVE_TAB);
        tab.classList.add(...ACTIVE_TAB);

        showByAttribute(descriptions, "data-theme-desc", themeId);
        showByAttribute(episodeLists, "data-theme-list", themeId);

        requestAnimationFrame(() => {
          window.dispatchEvent(new Event("episode-card:fit"));
        });
      });
    });
  }

  const scheduleThemeTabsInit = () => {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initThemeTabs, {
        once: true,
      });
      return;
    }
    initThemeTabs();
  };

  scheduleThemeTabsInit();
  document.addEventListener("astro:page-load", initThemeTabs);
</script>
