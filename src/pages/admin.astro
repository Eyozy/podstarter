                </button>
              </div>
              <textarea
                id="converted-markdown-output"
                readonly
                rows="18"
                style="height: 420px; min-height: 420px;"
                class="w-full p-3 font-mono text-xs bg-[#fbf9f6] border border-[#2d2a26]/15 rounded-xl text-[#2d2a26] resize-none block leading-relaxed overflow-y-auto"
              ></textarea>
              <div class="mt-3 flex items-center gap-2 h-9">
                <select id="bind-episode-select" class="text-xs border border-[#2d2a26]/15 rounded-lg px-2.5 font-mono min-w-0 flex-1 truncate bg-white h-full">
                  <option value="">-- 选择绑定的单集 --</option>
