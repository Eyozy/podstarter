                  </div>

                  <div>
                    <label class="block font-bold mb-1 font-serif text-xs">API Key *</label>
                    <input
                      type="password"
                      id="ai-form-key"
                      placeholder="填入服务商 API Key (sk-...)"
                      value={serverAiKey ? "••••••••••••••••" : ""}
                      class="w-full px-3 py-2 bg-[#faf9f7] border border-[#2d2a26]/15 rounded-lg font-mono text-xs focus:outline-none focus:border-orange-800 focus:bg-white"
                    />
                  </div>

                  <div>
                    <label class="block font-bold mb-1 font-serif text-xs">API 请求端点 URL</label>
                    <input
                      type="url"
                      id="ai-form-url"
                      value={serverAiUrl}
                      placeholder="https://api.deepseek.com/v1/chat/completions"
                      class="w-full px-3 py-2 bg-[#faf9f7] border border-[#2d2a26]/15 rounded-lg font-mono text-xs focus:outline-none focus:border-orange-800 focus:bg-white"
                    />
                  </div>

                  <div>
                    <label class="block font-bold mb-1 font-serif text-xs">模型名称 (Model)</label>
                    <input
                      type="text"
                      id="ai-form-model"
                      value={serverAiModel}
                      placeholder="deepseek-chat"
                      class="w-full px-3 py-2 bg-[#faf9f7] border border-[#2d2a26]/15 rounded-lg font-mono text-xs focus:outline-none focus:border-orange-800 focus:bg-white"
                    />
                  </div>
                </div>

                <div class="flex items-center gap-3 pt-1">
                  <button
                    type="submit"
                    id="btn-save-ai-form"
                    class="px-4 py-2 rounded-lg bg-[#2d2a26] text-white text-xs font-serif font-bold hover:bg-orange-800 transition-colors inline-flex items-center gap-2 shadow-xs cursor-pointer"
                  >
                    <i class="ri-save-line text-sm"></i>
                    保存并应用到环境变量
                  </button>
                  <span id="ai-config-feedback" class="text-xs font-mono"></span>
                </div>
              </form>
            </div>

            <div class="space-y-3">
              <button
                type="button"
                id="btn-toggle-ai-guide"
                class="w-full flex items-center justify-between p-3.5 bg-[#faf9f7] hover:bg-orange-50/40 border border-[#2d2a26]/10 rounded-xl text-xs font-serif text-[#2d2a26] transition-colors cursor-pointer"
              >
                <div class="flex items-center gap-2">
                  <i class="ri-file-code-line text-orange-800 text-sm"></i>
                  <span class="font-bold">查看各模型提供商配置模板与部署指引</span>
                </div>
                <i class="ri-arrow-down-s-line text-base transition-transform duration-200" id="icon-toggle-ai-guide"></i>
              </button>
              <div id="ai-guide-container" class="overflow-hidden transition-all duration-300 ease-in-out opacity-0 pointer-events-none space-y-3.5 pt-1" style="max-height: 0px;">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#2d2a26]/10 pb-3">
                  <div>
                    <h3 class="text-sm font-bold text-[#2d2a26] flex items-center gap-2 font-serif">
                      <i class="ri-file-code-line text-orange-800"></i>
                      选择提供商获取配置模板
                    </h3>
                    <p class="text-[11px] text-[#2d2a26]/60 mt-0.5 font-serif">
                      选择你使用的大模型服务商，直接复制对应变量内容：
                    </p>
                  </div>
                  <div class="flex items-center gap-2.5 self-start sm:self-auto">
                    <select
                      id="guide-provider-select"
                      class="px-3 py-1.5 border border-[#2d2a26]/15 rounded-lg font-mono text-xs focus:outline-none focus:border-orange-800 bg-white font-medium"
                    >
                      <option value="deepseek">DeepSeek</option>
                      <option value="zhipu">智谱</option>
                      <option value="xai">xAI</option>
                      <option value="openrouter">OpenRouter</option>
                      <option value="openai-compatible">OpenAI兼容接口</option>
                    </select>
                    <button
                      type="button"
                      id="btn-copy-env-template"
                      class="px-3 py-1.5 rounded-lg border border-[#2d2a26]/20 bg-white hover:bg-orange-50 text-xs font-mono text-orange-950 font-bold transition-colors inline-flex items-center gap-1.5 shadow-xs whitespace-nowrap shrink-0 cursor-pointer"
                    >
                      <i class="ri-file-copy-line text-sm text-orange-800"></i>
                      复制当前模板
                    </button>
                  </div>
                </div>

                <pre id="env-template-preview" class="p-3.5 sm:p-4 bg-[#2d2a26] text-white/90 rounded-xl font-mono text-xs leading-relaxed overflow-x-auto select-all"></pre>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 pt-0.5">
                  <div class="p-3.5 sm:p-4 rounded-xl border border-[#2d2a26]/10 bg-[#faf9f7] flex flex-col justify-between gap-2.5">
                    <div class="space-y-1">
                      <div class="flex items-center gap-1.5 font-bold text-xs text-[#2d2a26]">
                        <i class="ri-terminal-box-line text-orange-800"></i>
                        <span>本地开发 / 自建 VPS</span>
                      </div>
                      <p class="text-[11px] text-[#2d2a26]/65 leading-relaxed font-serif">
                        在项目根目录下创建 <code>.env</code> 文件并填入上述变量：
                      </p>
                    </div>
                    <div class="bg-[#2d2a26] text-white/90 px-3 py-1.5 rounded-lg font-mono text-[11px] flex justify-between items-center group">
                      <code id="text-cmd-local" class="select-all">cp .env.example .env</code>
                      <button
                        type="button"
                        id="btn-copy-cmd-local"
                        class="text-[10px] font-mono text-stone-300 hover:text-white flex items-center gap-1 transition-colors px-2.5 py-0.5 rounded bg-white/10 hover:bg-white/20 shrink-0 cursor-pointer font-bold"
                        title="点击复制"
                      >
                        <i class="ri-file-copy-line text-xs"></i>
                        <span>复制</span>
                      </button>
                    </div>
                  </div>

                  <div class="p-3.5 sm:p-4 rounded-xl border border-[#2d2a26]/10 bg-[#faf9f7] flex flex-col justify-between gap-2.5">
                    <div class="space-y-1">
                      <div class="flex items-center gap-1.5 font-bold text-xs text-[#2d2a26]">
                        <i class="ri-cloud-line text-orange-800"></i>
                        <span>部署在 Netlify / Vercel 线上平台</span>
                      </div>
                      <p class="text-[11px] text-[#2d2a26]/65 leading-relaxed font-serif">
                        登录云平台后台，在环境变量设置中填入上述变量：
                      </p>
                    </div>
                    <div class="bg-[#2d2a26]/5 border border-[#2d2a26]/10 text-[#2d2a26]/80 px-3 py-1.5 rounded-lg font-mono text-[11px] flex items-center gap-2">
                      <i class="ri-compass-discover-line text-orange-800 text-xs"></i>
                      <span>平台后台 ➔ Site Settings ➔ Environment Variables</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 pt-6 border-t border-[#2d2a26]/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-serif text-[#2d2a26]/60">
        <div class="flex items-center gap-2">
          <span class:list={["size-2 rounded-full shrink-0", isFsWritable ? "bg-emerald-600 animate-pulse" : "bg-amber-500"]}></span>
          <span>{isFsWritable ? "本地开发/独立服务器环境（控制台修改即时写盘持久化生效）" : "托管平台部署（只读文件沙盒，修改请在本地完成并通过 git push 触发云端自动构建）"}</span>
        </div>
        <div class="flex items-center gap-4 text-[11px] font-mono">
          <span>v{currentVersion}</span>
          <a href="https://github.com/Eyozy/podstarter#readme" target="_blank" rel="noopener noreferrer" class="hover:text-orange-800 transition-colors inline-flex items-center gap-1 font-serif text-xs">
            <i class="ri-book-open-line text-sm text-orange-800"></i>
            <span>使用说明与配置 ↗</span>
          </a>
        </div>
      </div>
    </div>
  )}

  <div id="password-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#2d2a26]/60 backdrop-blur-sm hidden" role="dialog" aria-modal="true">
    <div class="bg-white rounded-2xl border border-[#2d2a26]/10 shadow-2xl max-w-md w-full p-6 sm:p-7 space-y-5 animate-in fade-in zoom-in-95 duration-200">
      <div class="flex justify-between items-start">
        <div class="flex items-center gap-2.5">
          <div class="size-9 rounded-xl bg-orange-50 border border-orange-200 text-orange-800 flex items-center justify-center shrink-0">
            <i class="ri-shield-keyhole-line text-lg"></i>
          </div>
          <div>
            <h3 class="font-bold text-base text-[#2d2a26] font-serif">修改管理员密码</h3>
            <p class="text-[11px] text-[#2d2a26]/60 font-serif">更新本地 .env 中的 ADMIN_PASSWORD 并自动续期</p>
          </div>
        </div>
        <button type="button" id="btn-close-password-modal" class="text-[#2d2a26]/40 hover:text-[#2d2a26] p-1 cursor-pointer" aria-label="关闭">
          <i class="ri-close-line text-lg"></i>
        </button>
      </div>

      <div class="space-y-4">
        <div>
          <label class="block font-bold mb-1 font-serif text-xs text-[#2d2a26]">新管理员密码 *</label>
          <input
            type="password"
            id="admin-new-password"
            placeholder="输入至少 6 位的新密码"
            class="w-full px-3.5 py-2 bg-[#faf9f7] border border-[#2d2a26]/15 rounded-lg font-mono text-xs focus:outline-none focus:border-orange-800 focus:bg-white"
          />
        </div>
        <div>
          <label class="block font-bold mb-1 font-serif text-xs text-[#2d2a26]">确认新密码 *</label>
          <input
            type="password"
            id="admin-confirm-password"
            placeholder="再次输入新密码"
            class="w-full px-3.5 py-2 bg-[#faf9f7] border border-[#2d2a26]/15 rounded-lg font-mono text-xs focus:outline-none focus:border-orange-800 focus:bg-white"
          />
        </div>
      </div>

      <div class="pt-2 flex items-center justify-between gap-3 border-t border-[#2d2a26]/10">
        <span id="change-password-feedback" class="text-xs font-mono"></span>
        <div class="flex items-center gap-2 shrink-0">
          <button type="button" id="btn-cancel-password-modal" class="px-3.5 py-2 rounded-lg border border-[#2d2a26]/20 bg-white hover:bg-orange-50 text-xs font-serif font-bold text-[#2d2a26] cursor-pointer">
            取消
          </button>
          <button type="button" id="btn-change-password" class="px-4 py-2 rounded-lg bg-orange-800 hover:bg-orange-900 text-white font-serif text-xs font-bold transition-colors inline-flex items-center gap-1.5 shadow-sm cursor-pointer">
            <i class="ri-check-line text-sm"></i>
            确认修改
          </button>
        </div>
      </div>
    </div>
  </div>
  </div>
</MainLayout>

<script is:inline define:vars={{ initialMembers: site.about?.members || [], initialVersion: currentVersion, envTemplates }}>
  function initAdminConsole() {
    const consoleRoot = document.querySelector("[data-admin-console]");
    if (!consoleRoot || consoleRoot.dataset.bound === "true") return;
    consoleRoot.dataset.bound = "true";
    function escapeAttr(str) {
      return String(str || "")
        .replace(/&/g, "&amp;")
        .replace(/"/g, "&quot;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    }

    const descTextarea = document.getElementById("podcast-description-input");
    if (descTextarea) {
      const resize = () => {
        descTextarea.style.height = "auto";
        descTextarea.style.height = Math.max(72, descTextarea.scrollHeight) + "px";
      };
      descTextarea.addEventListener("input", resize);
      requestAnimationFrame(resize);
      setTimeout(resize, 100);
    }

    document.getElementById("btn-logout")?.addEventListener("click", async () => {
      await fetch("/api/admin", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "logout" }),
      });
      window.location.href = "/";
    });

    try {
      fetch("https://api.github.com/repos/Eyozy/podstarter/releases/latest")
        .then((res) => res.json())
        .then((data) => {
          if (data && data.tag_name) {
            const upstreamVer = String(data.tag_name).replace(/^v/i, "");
            if (upstreamVer && upstreamVer !== initialVersion) {
              const banner = document.getElementById("upstream-version-banner");
              const title = document.getElementById("upstream-version-title");
              if (banner && title) {
                title.textContent = `检测到 PodStarter 模板发布了新版本 v${upstreamVer}（当前 v${initialVersion}）！`;
                banner.classList.remove("hidden");
              }
            }
          }
        })
        .catch(() => {});
    } catch {}

    const quickRssUrl = document.getElementById("quick-rss-url");
    const btnQuickSyncRss = document.getElementById("btn-quick-sync-rss");
    const quickRssMeta = document.getElementById("quick-rss-meta-checkbox");
    const quickRssFeedback = document.getElementById("quick-rss-feedback");

    btnQuickSyncRss?.addEventListener("click", async () => {
      const url = quickRssUrl?.value?.trim();
      if (!url) {
        window.toast?.warning("请先粘贴播客主页链接或 RSS 订阅源地址");
        return;
      }

      btnQuickSyncRss.disabled = true;
      btnQuickSyncRss.textContent = "正在抓取解析...";
      if (quickRssFeedback) {
        quickRssFeedback.className = "text-xs font-mono text-orange-300";
        quickRssFeedback.textContent = "正在智能识别平台并解析全量节目，请稍候...";
      }

      try {
        const res = await fetch("/api/admin", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action: "sync-rss",
            rssUrl: url,
            updateSiteMeta: quickRssMeta?.checked !== false,
          }),
        });
        const data = await res.json();
        if (data.success) {
          if (quickRssFeedback) {
            quickRssFeedback.className = "text-xs font-mono text-emerald-400";
            const platformTag = data.platform ? ` [平台: ${data.platform}]` : "";
            quickRssFeedback.textContent = `成功导入《${data.podcastTitle}》共 ${data.count} 期节目${platformTag}！页面即将刷新...`;
          }
          setTimeout(() => {
            window.location.reload();
          }, 1200);
        } else {
          const err = "解析失败: " + (data.error || "未知错误");
          window.toast?.error(err);
          btnQuickSyncRss.disabled = false;
          btnQuickSyncRss.textContent = "一键解析导入";
          if (quickRssFeedback) quickRssFeedback.textContent = "";
        }
      } catch (err) {
        const errTxt = "网络请求异常: " + err.message;
        window.toast?.error(errTxt);
        btnQuickSyncRss.disabled = false;
        btnQuickSyncRss.textContent = "一键解析导入";
        if (quickRssFeedback) quickRssFeedback.textContent = "";
      }
    });


    const searchInput = document.getElementById("episode-search");
    const filterStatus = document.getElementById("filter-status");
    const rows = document.querySelectorAll(".episode-row");

    function applyFilter() {
      const q = (searchInput?.value || "").trim().toLowerCase();
      const status = filterStatus?.value || "all";

      rows.forEach((row) => {
        const title = row.getAttribute("data-title") || "";
        const id = row.getAttribute("data-id") || "";
        const epStatus = row.getAttribute("data-status") || "";

        const matchesQuery = !q || title.includes(q) || id.includes(q);
        const matchesStatus = status === "all" || epStatus === status;

        if (matchesQuery && matchesStatus) {
          row.classList.remove("hidden");
        } else {
          row.classList.add("hidden");
        }
      });
    }

    searchInput?.addEventListener("input", applyFilter);
    filterStatus?.addEventListener("change", applyFilter);

    document.querySelectorAll(".delete-episode-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-id");
        const title = btn.getAttribute("data-title");
        if (!id) return;

        if (!confirm(`确定要从本地数据库中删除单集《${title}》吗？\n对应的文字稿也会被清理。`)) {
          return;
        }

        btn.textContent = "删除中...";
        try {
          const res = await fetch("/api/admin", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "delete-episode", episodeId: id }),
          });
          const data = await res.json();
          if (data.success) {
            const row = btn.closest(".episode-row");
            if (row) {
              row.style.transition = "all 0.25s cubic-bezier(0.4, 0, 0.2, 1)";
              row.style.opacity = "0";
              row.style.transform = "translateX(16px)";
              setTimeout(() => {
                row.remove();
              }, 250);
            }
          } else {
            btn.textContent = "删除";
          }
        } catch (err) {
          const errTxt = "请求异常: " + err.message;
          window.toast?.error(errTxt);
          btn.textContent = "删除";
        }
      });
    });

    document.querySelectorAll(".simulate-play-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-id");
        if (!id) return;
        btn.disabled = true;
        btn.textContent = "上报中...";

        try {
          const res = await fetch("/api/play", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ episodeId: id }),
          });
          const data = await res.json();
          if (!res.ok) {
            throw new Error(data?.error || `HTTP ${res.status}`);
          }
          if (data?.success) {
            const badge = btn.closest(".episode-row")?.querySelector(".play-count-badge");
            if (badge) badge.textContent = String(data.count);
            const totalMetric = document.getElementById("metric-total-plays");
            if (totalMetric) totalMetric.textContent = String(Number(totalMetric.textContent || "0") + 1);
            btn.textContent = "+1 成功";
            setTimeout(() => {
              btn.textContent = "+1 试听";
              btn.disabled = false;
            }, 1200);
          }
        } catch {
          btn.textContent = "失败";
          setTimeout(() => {
            btn.textContent = "+1 试听";
            btn.disabled = false;
          }, 1200);
        }
      });
    });

    const rawSubtitles = document.getElementById("raw-subtitles-input");
    const convertedOutput = document.getElementById("converted-markdown-output");
    const convertBtn = document.getElementById("btn-convert-subtitles");
    const loadSampleBtn = document.getElementById("load-sample-srt");
    const loadSampleMixedBtn = document.getElementById("load-sample-mixed");
    const copyMdBtn = document.getElementById("btn-copy-markdown");
    const saveTranscriptBtn = document.getElementById("btn-save-transcript-file");
    const bindEpisodeSelect = document.getElementById("bind-episode-select");
    const saveFeedback = document.getElementById("save-transcript-feedback");

    loadSampleBtn?.addEventListener("click", () => {
      if (rawSubtitles) {
        rawSubtitles.value = `1\n00:00:02,000 --> 00:00:06,000\n[主播 A]: 欢迎收听 PodStarter 播客节目。\n\n2\n00:00:07,000 --> 00:00:12,500\n[主播 B]: 今天我们聊聊如何通过独立站掌控播客主权。`;
      }
    });

    loadSampleMixedBtn?.addEventListener("click", () => {
      if (rawSubtitles) {
        rawSubtitles.value = `00:02:05 [主播 A] 很高兴污染你的房间。\n02:15 嘉宾：今天我们聊聊怎么制造变化。\n01:05:20 **主播 B**: 新的骨骼会从旧伤的钙化里生长出来。\n10:30 时间节点示例：从沙漠到工位。`;
      }
    });

    convertBtn?.addEventListener("click", async () => {
      const text = rawSubtitles?.value || "";
      if (!text.trim()) {
        window.toast?.warning("请先输入或粘贴字幕内容");
        return;
      }

      convertBtn.disabled = true;
      convertBtn.textContent = "智能解析中...";

      try {
        const res = await fetch("/api/admin", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "convert-subtitles", subtitles: text }),
        });
        const data = await res.json();
        if (data.success && convertedOutput) {
          convertedOutput.value = data.markdown;
        } else {
          const err = "解析失败: " + (data.error || "未能识别到时间戳");
          window.toast?.error(err);
        }
      } catch (err) {
        const errTxt = "网络错误: " + err.message;
        window.toast?.error(errTxt);
      } finally {
        convertBtn.disabled = false;
        convertBtn.textContent = "开始智能解析转化";
      }
    });

    copyMdBtn?.addEventListener("click", () => {
      if (convertedOutput && convertedOutput.value) {
        navigator.clipboard.writeText(convertedOutput.value);
        copyMdBtn.textContent = "已复制";
        setTimeout(() => (copyMdBtn.textContent = "复制 Markdown"), 1500);
      }
    });

    saveTranscriptBtn?.addEventListener("click", async () => {
      const md = convertedOutput?.value;
      const episodeId = bindEpisodeSelect?.value;
      if (!episodeId) {
        window.toast?.warning("请选择要绑定的单集");
        return;
      }
      if (!md) {
        window.toast?.warning("文字稿内容为空，请先转换字幕");
        return;
      }

      saveTranscriptBtn.disabled = true;
      if (saveFeedback) saveFeedback.textContent = "正在写入文件...";

      try {
        const res = await fetch("/api/admin", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "save-transcript", episodeId, markdown: md }),
        });
        const data = await res.json();
        if (data.success) {
          if (saveFeedback) {
            saveFeedback.className = "text-[11px] font-mono mt-1 block text-emerald-700";
            saveFeedback.textContent = `已成功写入 src/content/transcripts/${data.filePath}`;
          }
        } else {
          if (saveFeedback) {
            saveFeedback.className = "text-[11px] font-mono mt-1 block text-red-700";
            saveFeedback.textContent = "保存失败: " + data.error;
          }
        }
      } catch (err) {
        if (saveFeedback) {
          saveFeedback.className = "text-[11px] font-mono mt-1 block text-red-700";
          saveFeedback.textContent = "请求异常: " + err.message;
        }
      } finally {
        saveTranscriptBtn.disabled = false;
      }
    });


    const membersContainer = document.getElementById("members-container");
    const btnAddMember = document.getElementById("btn-add-member");

    let membersData = Array.isArray(initialMembers) ? JSON.parse(JSON.stringify(initialMembers)) : [];

    function renderMembersUI() {
      if (!membersContainer) return;
      membersContainer.innerHTML = "";

      if (membersData.length === 0) {
        membersContainer.innerHTML = `
          <div class="p-6 text-center border border-dashed border-[#2d2a26]/15 rounded-xl bg-[#faf9f7] text-[#2d2a26]/50 text-xs">
