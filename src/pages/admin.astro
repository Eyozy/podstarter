---
import MainLayout from "../layouts/MainLayout.astro";
import { loadSiteConfig } from "../../scripts/siteConfig.js";
const site = loadSiteConfig();
import { publishedEpisodes, formatEpisodeDate } from "../utils/episodes";
import fs from "node:fs";
import path from "node:path";
import { isValidAdminCookie, isValidTranscriptId, resolveAdminPassword, readEnvMap } from "../utils/auth";
import { getProviderEnvPrefix } from "../../scripts/aiProviderConfig.js";

export const prerender = false;

const cookieHeader = Astro.request.headers.get("cookie") || "";
const isAuthenticated = isValidAdminCookie(cookieHeader, resolveAdminPassword());
const adminPasswordConfigured = Boolean(resolveAdminPassword());

const playCountsPath = path.join(process.cwd(), "src/data/play-counts.json");
let playCounts: Record<string, number> = {};
try {
  if (fs.existsSync(playCountsPath)) {
    playCounts = JSON.parse(fs.readFileSync(playCountsPath, "utf-8")) || {};
  }
} catch {}

const totalPlays = Object.values(playCounts).reduce((a, b) => a + b, 0);

const themesPath = path.join(process.cwd(), "src/data/themes.json");
let themesList: Array<{ id: string; title: string; description?: string }> = [];
try {
  if (fs.existsSync(themesPath)) {
    themesList = JSON.parse(fs.readFileSync(themesPath, "utf-8")) || [];
  }
} catch {}

const envExample = fs.existsSync(path.join(process.cwd(), ".env.example"))
  ? fs.readFileSync(path.join(process.cwd(), ".env.example"), "utf-8")
  : "";

const envTemplates = Object.fromEntries(
  ["deepseek", "openrouter", "xai", "zhipu", "openai-compatible"].map((provider) => {
    const prefix = getProviderEnvPrefix(provider);
    const block = envExample
      .split(/\n\s*\n/u)
      .find((chunk) => chunk.includes(`${prefix}_API_KEY`));
    return [provider, block ? `AI_PROVIDER=${provider}\n${block.trim()}\n` : ""];
  })
);

const transcriptsDir = path.join(process.cwd(), "src/content/transcripts");
const placeholderNotice = site.transcripts?.placeholderNotice?.trim() || "";

let realReadyCount = 0;
let placeholderCount = 0;
let missingCount = 0;

const episodesData = publishedEpisodes.map((ep) => {
  const transcriptFile = isValidTranscriptId(ep.id)
    ? path.join(transcriptsDir, `${ep.id}.md`)
    : null;
  let status: "ready" | "placeholder" | "missing" = "missing";

  if (transcriptFile && fs.existsSync(transcriptFile)) {
    const content = fs.readFileSync(transcriptFile, "utf-8");
    if (placeholderNotice && content.includes(placeholderNotice)) {
      status = "placeholder";
      placeholderCount++;
    } else {
      status = "ready";
      realReadyCount++;
    }
  } else {
    missingCount++;
  }

  return {
    ...ep,
    plays: playCounts[ep.id] || 0,
    transcriptStatus: status,
  };
});
const envMap = readEnvMap();
const aiEnvProvider = String(process.env.AI_PROVIDER || envMap.AI_PROVIDER || "").trim();
const envPrefix = getProviderEnvPrefix(aiEnvProvider) || "";
const serverAiKey = (envPrefix && (process.env[`${envPrefix}_API_KEY`] || envMap[`${envPrefix}_API_KEY`])) || "";
const hasServerAiKey = Boolean(serverAiKey);
const serverAiModel = (envPrefix && (process.env[`${envPrefix}_MODEL`] || envMap[`${envPrefix}_MODEL`])) || "";
const serverAiUrl = (envPrefix && (process.env[`${envPrefix}_API_URL`] || envMap[`${envPrefix}_API_URL`])) || "";
let isFsWritable = true;
try {
  const testDir = path.join(process.cwd(), "src/data");
  fs.accessSync(testDir, fs.constants.W_OK);
} catch {
  isFsWritable = false;
}

const currentVersion = "1.1.0";
const pageTitle = "管理控制台 | " + site.brand.name;
---

<MainLayout title={pageTitle}>
  <div class="w-full font-serif" data-admin-root>
    {!isAuthenticated ? (
            <div class="max-w-md mx-auto py-16 sm:py-24">
        <div class="bg-white rounded-2xl border border-[#2d2a26]/10 shadow-sm p-6 sm:p-8 text-center">
          <div class="size-12 rounded-2xl bg-orange-50 border border-orange-200/80 text-orange-800 flex items-center justify-center mx-auto mb-4">
            <i class="ri-lock-2-line text-2xl"></i>
          </div>
          <h1 class="text-xl font-bold text-[#2d2a26] mb-1 font-serif">管理控制台登录</h1>
          <p class="text-xs text-[#2d2a26]/60 font-serif leading-relaxed mb-6">
            请输入管理员密码进入后台。
          </p>
          {!adminPasswordConfigured && (
            <div class="mb-5 text-left p-3 rounded-lg bg-amber-50/90 border border-amber-200/80 text-amber-900 text-xs font-serif leading-relaxed">
              <div class="flex items-center gap-1.5 font-bold mb-1 text-amber-950 font-mono">
                <i class="ri-alert-line text-sm text-amber-700"></i>
                <span>尚未配置管理员密码</span>
              </div>
              服务端尚未检测到 <code class="font-mono bg-white px-1 py-0.5 rounded border border-amber-200 text-amber-950 font-bold">ADMIN_PASSWORD</code>。请先在本地 <code class="font-mono bg-white px-1 py-0.5 rounded border border-amber-200 text-amber-950 font-bold">.env</code> 或平台环境变量中配置密码后再试。
            </div>
          )}

          <form id="admin-login-form" class="space-y-4" onsubmit="event.preventDefault(); window.__doAdminLogin(); return false;">
            <div class="text-left">
              <label class="block font-mono text-xs font-bold mb-1 text-[#2d2a26]">管理员密码 *</label>
              <input
                type="password"
                id="admin-login-password"
                required
                placeholder="输入管理员密码"
                class="w-full px-3.5 py-2.5 bg-[#faf9f7] border border-[#2d2a26]/15 rounded-lg text-xs font-mono focus:outline-none focus:border-orange-800 focus:bg-white"
                onkeydown="if(event.key==='Enter'){event.preventDefault();window.__doAdminLogin();}"
              />
            </div>
            <button
              type="button"
              id="btn-admin-login"
              onclick="window.__doAdminLogin()"
              class="w-full py-2.5 bg-[#2d2a26] hover:bg-orange-800 text-white rounded-lg text-xs font-mono font-bold transition-colors inline-flex items-center justify-center gap-2 shadow-sm cursor-pointer"
            >
              <i class="ri-login-box-line text-sm"></i>
              验证并进入控制台
            </button>

          </form>
          <div class="mt-6 pt-4 border-t border-[#2d2a26]/10 text-center">
            <a
              href="https://github.com/Eyozy/podstarter/issues"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-[11px] text-[#2d2a26]/60 hover:text-orange-800 transition-colors font-serif"
            >
              <i class="ri-github-line text-xs"></i>
              <span>遇到问题？前往 GitHub 提交反馈</span>
            </a>
          </div>
          <script is:inline>
            window.__doAdminLogin = async function() {
              const passInput = document.getElementById("admin-login-password");
              const btn = document.getElementById("btn-admin-login");
              const password = passInput ? passInput.value.trim() : "";
              
              if (!password) {
                if (window.toast) window.toast.warning("请输入管理员密码");
                if (passInput) passInput.focus();
                return;
              }

              if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="ri-loader-4-line text-sm animate-spin"></i> 验证中...';
              }

              try {
                const res = await fetch("/api/admin", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ action: "login", password }),
                });
                const data = await res.json().catch(() => ({}));
                if (res.ok && data.success) {
                  window.location.href = "/admin?auth=" + Date.now();
                } else {
                  const err = data.error || (res.status === 503 ? "服务端未配置管理员密码" : "密码错误，请核对后重试");

                  if (window.toast) window.toast.error(err);
                  if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="ri-login-box-line text-sm"></i> 验证并进入控制台';
                  }
                }
              } catch (err) {
                const msg = "网络异常: " + (err && err.message ? err.message : "请稍后重试");

                if (window.toast) window.toast.error(msg);
                if (btn) {
                  btn.disabled = false;
                  btn.innerHTML = '<i class="ri-login-box-line text-sm"></i> 验证并进入控制台';
                }
              }
            };
          </script>
        </div>
      </div>
    ) : (
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12" data-admin-console>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#2d2a26]/10 pb-6 mb-8">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#2d2a26] flex items-center gap-2.5">
            <i class="ri-settings-3-line text-orange-800 text-2xl sm:text-3xl"></i>
            <span>管理控制台</span>
          </h1>
        </div>

        <div class="flex items-center gap-2 sm:gap-2.5 flex-wrap">
          <button
            type="button"
            id="btn-open-password-modal"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[#2d2a26]/20 bg-white hover:bg-orange-50 text-[#2d2a26] text-xs font-serif font-bold transition-all shadow-xs cursor-pointer"
            title="修改后台管理员登录密码"
          >
            <i class="ri-shield-keyhole-line text-sm text-orange-800"></i>
            <span>修改密码</span>
          </button>
          <button
            type="button"
            id="btn-logout"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[#2d2a26]/20 bg-white hover:bg-orange-50 text-[#2d2a26] text-xs font-serif font-bold transition-all shadow-xs cursor-pointer"
          >
            <i class="ri-logout-box-r-line text-sm text-orange-800"></i>
            退出
          </button>
          <a
            href="https://github.com/Eyozy/podstarter/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[#2d2a26]/20 bg-white hover:bg-orange-50 text-[#2d2a26] text-xs font-serif font-bold transition-all shadow-xs cursor-pointer"
            title="前往 GitHub 提交反馈与问题"
          >
            <i class="ri-github-line text-sm text-orange-800"></i>
            <span>反馈建议</span>
          </a>
          <a
            href="/rss.xml"
            target="_blank"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[#2d2a26]/20 text-xs font-serif font-semibold text-[#2d2a26] hover:bg-orange-50 transition-colors"
          >
            <i class="ri-rss-line text-sm text-orange-800"></i>
            /rss.xml
          </a>
          <a
            href="/"
            target="_blank"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#2d2a26] text-white text-xs font-serif font-semibold hover:bg-orange-800 transition-colors cursor-pointer"
          >
            <i class="ri-external-link-line text-sm"></i>
            <span>预览播客</span>
          </a>
        </div>
      </div>

      <div id="upstream-version-banner" class="mb-8 p-4 sm:p-5 rounded-2xl border border-orange-200 bg-orange-50/80 text-[#2d2a26] text-xs font-serif flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
        <div class="flex items-center gap-2.5">
          <i class="ri-information-line text-lg text-orange-800 shrink-0"></i>
          <div>
            <span class="font-bold text-orange-950 font-serif" id="upstream-version-title">检测到 PodStarter 模板有新版本发布！</span>
            <p class="text-[11px] text-[#2d2a26]/70 mt-0.5 font-serif">你的 GitHub Fork 已配置自动同步工作流，也可在仓库首页点击 “Sync fork” 一键同步更新。</p>
          </div>
        </div>
        <a
          href="https://github.com/Eyozy/podstarter"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-orange-900 font-serif font-bold hover:underline text-xs shrink-0 self-start sm:self-auto"
        >
          <span>查看上游更新日志</span>
        </a>
      </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-2xl p-5 border border-[#2d2a26]/10 shadow-sm">
          <div class="flex items-center justify-between text-[#2d2a26]/50 mb-1">
            <span class="text-xs font-mono uppercase tracking-wider">已发布节目</span>
            <i class="ri-mic-line text-base text-[#2d2a26]/60"></i>
          </div>
          <div class="text-2xl sm:text-3xl font-bold font-mono text-[#2d2a26]">
            {publishedEpisodes.length}
          </div>
          <p class="text-[11px] text-[#2d2a26]/50 mt-1 font-serif">独立站全网分发期数</p>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-[#2d2a26]/10 shadow-sm">
          <div class="flex items-center justify-between text-[#2d2a26]/50 mb-1">
            <span class="text-xs font-mono uppercase tracking-wider">全站收听数</span>
            <i class="ri-play-circle-line text-base text-orange-800"></i>
          </div>
          <div class="text-2xl sm:text-3xl font-bold font-mono text-orange-800" id="metric-total-plays">
            {totalPlays}
          </div>
          <p class="text-[11px] text-[#2d2a26]/50 mt-1 font-serif">独立播放器有效请求</p>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-[#2d2a26]/10 shadow-sm">
          <div class="flex items-center justify-between text-[#2d2a26]/50 mb-1">
            <span class="text-xs font-mono uppercase tracking-wider">文字稿已就绪</span>
            <i class="ri-checkbox-circle-line text-base text-emerald-600"></i>
          </div>
          <div class="text-2xl sm:text-3xl font-bold font-mono text-emerald-700">
            {realReadyCount}
            <span class="text-sm font-normal text-[#2d2a26]/40">/ {publishedEpisodes.length}</span>
          </div>
          <p class="text-[11px] text-[#2d2a26]/50 mt-1 font-serif">具备实际正文的文字稿</p>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-[#2d2a26]/10 shadow-sm">
          <div class="flex items-center justify-between text-[#2d2a26]/50 mb-1">
            <span class="text-xs font-mono uppercase tracking-wider">待整理文字稿</span>
            <i class="ri-error-warning-line text-base text-amber-600"></i>
          </div>
          <div class="text-2xl sm:text-3xl font-bold font-mono text-amber-700">
            {placeholderCount}
          </div>
          <p class="text-[11px] text-[#2d2a26]/50 mt-1 font-serif">含占位标记，待转录</p>
        </div>
      </div>

      <div class="bg-white text-[#2d2a26] p-6 sm:p-7 rounded-2xl shadow-sm mb-8 border border-[#2d2a26]/10 w-full">
        <div class="flex items-center gap-2 mb-2">
          <i class="ri-rss-line text-lg text-orange-800"></i>
          <h2 class="text-base sm:text-lg font-bold font-serif">一键从各大平台或 RSS 订阅源同步与解析</h2>
        </div>
        <p class="text-xs text-[#2d2a26]/70 mb-4 leading-relaxed font-serif w-full">
          支持直接粘贴小宇宙、Apple Podcasts、喜马拉雅、网易云等全网主流播客主页链接或标准 RSS XML 地址。系统自动智能反查识别并抓取全部历史单集、音频直链与 ShowNotes，直接生成独立站！
        </p>

        <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center w-full">
          <div class="relative flex-1">
            <input
              type="url"
              id="quick-rss-url"
              placeholder="粘贴小宇宙 / Apple Podcasts / 喜马拉雅 / 网易云链接，或标准 RSS 地址..."
              class="w-full px-3.5 py-2.5 bg-[#faf9f7] border border-[#2d2a26]/15 rounded-lg text-[#2d2a26] placeholder-[#2d2a26]/40 text-xs font-mono focus:outline-none focus:border-orange-800 focus:bg-white transition-colors"
            />
          </div>
          <button
            type="button"
            id="btn-quick-sync-rss"
            class="px-5 py-2.5 rounded-lg bg-orange-800 hover:bg-orange-900 text-white font-serif text-xs font-bold transition-colors inline-flex items-center justify-center gap-2 whitespace-nowrap shadow-sm cursor-pointer"
          >
            <i class="ri-refresh-line text-sm"></i>
            一键解析导入
          </button>
        </div>

        <div class="flex items-center gap-4 mt-3 text-[11px] text-[#2d2a26]/60 font-mono">
          <label class="inline-flex items-center gap-1.5 cursor-pointer">
            <input type="checkbox" id="quick-rss-meta-checkbox" checked class="rounded border-[#2d2a26]/20 text-orange-800 focus:ring-0" />
            <span>同步更新播客名称、封面与简介</span>
          </label>
          <span id="quick-rss-feedback" class="text-xs font-mono"></span>
        </div>
      </div>

            <div class="flex border-b border-[#2d2a26]/10 mb-6 gap-2 sm:gap-4 overflow-x-auto" id="admin-tabs">
        <button
          type="button"
          data-tab="episodes"
          onclick="window.__switchAdminTab('episodes')"
          class="tab-btn px-4 py-2.5 font-mono text-xs font-bold border-b-2 border-orange-800 text-orange-950 flex items-center gap-2 whitespace-nowrap transition-colors cursor-pointer"
        >
          <i class="ri-list-check-2 text-sm text-orange-800"></i>
          全部单集 ({publishedEpisodes.length})
        </button>

        <button
          type="button"
          data-tab="subtitles"
          onclick="window.__switchAdminTab('subtitles')"
          class="tab-btn px-4 py-2.5 font-mono text-xs font-bold border-b-2 border-transparent text-[#2d2a26]/60 hover:text-[#2d2a26] flex items-center gap-2 whitespace-nowrap transition-colors cursor-pointer"
        >
          <i class="ri-chat-voice-line text-sm"></i>
          字幕转文字
        </button>

        <button
          type="button"
          data-tab="about-team"
          onclick="window.__switchAdminTab('about-team')"
          class="tab-btn px-4 py-2.5 font-mono text-xs font-bold border-b-2 border-transparent text-[#2d2a26]/60 hover:text-[#2d2a26] flex items-center gap-2 whitespace-nowrap transition-colors cursor-pointer"
        >
          <i class="ri-team-line text-sm"></i>
          主播与关于
        </button>

        <button
          type="button"
          data-tab="config"
          onclick="window.__switchAdminTab('config')"
          class="tab-btn px-4 py-2.5 font-mono text-xs font-bold border-b-2 border-transparent text-[#2d2a26]/60 hover:text-[#2d2a26] flex items-center gap-2 whitespace-nowrap transition-colors cursor-pointer"
        >
          <i class="ri-settings-line text-sm"></i>
          平台与设置
        </button>

        <button
          type="button"
          data-tab="ai-settings"
          onclick="window.__switchAdminTab('ai-settings')"
          class="tab-btn px-4 py-2.5 font-mono text-xs font-bold border-b-2 border-transparent text-[#2d2a26]/60 hover:text-[#2d2a26] flex items-center gap-2 whitespace-nowrap transition-colors cursor-pointer"
        >
          <i class="ri-brain-line text-sm"></i>
          AI 设置
        </button>
      </div>
      <script is:inline>
        window.__switchAdminTab = function(targetTab) {
          const tabs = ["episodes", "subtitles", "about-team", "config", "ai-settings"];
          if (!tabs.includes(targetTab)) return;
          try {
            history.replaceState(null, "", "#" + targetTab);
          } catch (e) {}
          tabs.forEach(function(tabName) {
            const btn = document.querySelector('#admin-tabs [data-tab="' + tabName + '"]');
            const panel = document.getElementById("panel-" + tabName);
            if (tabName === targetTab) {
              if (btn) {
                btn.className = "tab-btn px-4 py-2.5 font-mono text-xs font-bold border-b-2 border-orange-800 text-orange-950 flex items-center gap-2 whitespace-nowrap transition-colors cursor-pointer";
              }
              if (panel) {
                panel.classList.remove("hidden");
                panel.classList.remove("tab-pane-animate");
                void panel.offsetWidth;
                panel.classList.add("tab-pane-animate");
              }
            } else {
              if (btn) {
                btn.className = "tab-btn px-4 py-2.5 font-mono text-xs font-bold border-b-2 border-transparent text-[#2d2a26]/60 hover:text-[#2d2a26] flex items-center gap-2 whitespace-nowrap transition-colors cursor-pointer";
              }
              if (panel) {
                panel.classList.add("hidden");
                panel.classList.remove("tab-pane-animate");
              }
            }
          });
        };

        function applyInitialTab() {
          try {
            const initialHash = window.location.hash.replace(/^#/, "");
            if (["episodes", "subtitles", "about-team", "config", "ai-settings"].includes(initialHash)) {
              window.__switchAdminTab(initialHash);
            }
          } catch (e) {}
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", applyInitialTab);
        } else {
          applyInitialTab();
        }
        window.addEventListener("hashchange", applyInitialTab);
      </script>

      <div id="panel-episodes" class="tab-panel">
        <div class="bg-white rounded-2xl border border-[#2d2a26]/10 shadow-sm overflow-hidden w-full">
                    <div class="p-4 sm:p-5 border-b border-[#2d2a26]/10 bg-[#fdfcfa] flex flex-col sm:flex-row gap-3 justify-between items-center">
            <div class="relative w-full sm:w-80">
            <i class="ri-search-line absolute left-3 top-1/2 -translate-y-1/2 text-[#2d2a26]/40 text-sm"></i>
              <input
                type="text"
                id="episode-search"
                placeholder="搜索标题或单集 ID..."
                class="w-full pl-9 pr-3 py-1.5 text-xs bg-white border border-[#2d2a26]/15 rounded-lg focus:outline-none focus:border-orange-800 font-sans"
              />
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto">
              <select
                id="filter-status"
                class="text-xs bg-white border border-[#2d2a26]/15 rounded-lg px-2.5 py-1.5 text-[#2d2a26] focus:outline-none focus:border-orange-800 font-mono"
              >
                <option value="all">全部文字稿状态</option>
                <option value="ready">仅文字稿已就绪</option>
                <option value="placeholder">仅待整理占位</option>
                <option value="missing">仅暂缺文字稿</option>
              </select>
            </div>
          </div>

                    <div class="overflow-x-auto max-h-130">
            <table class="w-full text-left border-collapse text-xs" id="episodes-table">
              <thead class="sticky top-0 bg-[#f9f8f6] border-b border-[#2d2a26]/10 text-[#2d2a26]/70 font-mono">
                <tr>
                  <th class="py-3 px-4">标题 / 单集 ID</th>
                  <th class="py-3 px-4">发布时间</th>
                  <th class="py-3 px-4">时长</th>
                  <th class="py-3 px-4">文字稿真实状态</th>
                  <th class="py-3 px-4 text-right">独立站收听</th>
                  <th class="py-3 px-4 text-center">操作</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#2d2a26]/5 font-sans" id="episodes-tbody">
                {episodesData.length === 0 ? (
                  <tr>
                    <td colspan="6" class="py-12 text-center text-[#2d2a26]/40 font-mono">
                      暂未同步播客节目。请在上方输入你的 RSS 订阅源地址并点击“一键解析导入”。
                    </td>
                  </tr>
                ) : (
                  episodesData.map((ep) => (
                    <tr class="episode-row hover:bg-orange-50/20 transition-colors" data-id={ep.id} data-title={ep.title.toLowerCase()} data-status={ep.transcriptStatus}>
                      <td class="py-3 px-4 font-bold text-[#2d2a26] max-w-70">
                        <div class="truncate" title={ep.title}>
                          <a href={`/episodes/${ep.id}`} target="_blank" class="hover:text-orange-800 transition-colors">
                            {ep.title}
                          </a>
                        </div>
                        <div class="text-[10px] font-mono text-[#2d2a26]/40 font-normal truncate mt-0.5">
                          ID: {ep.id}
                        </div>
                      </td>
                      <td class="py-3 px-4 text-[#2d2a26]/60 font-mono text-[11px] whitespace-nowrap">
                        {formatEpisodeDate(ep.pubDate)}
                      </td>
                      <td class="py-3 px-4 text-[#2d2a26]/60 font-mono text-[11px] whitespace-nowrap">
                        {ep.itunes?.duration || "--:--"}
                      </td>
                      <td class="py-3 px-4 whitespace-nowrap">
                        {ep.transcriptStatus === "ready" && (
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/60">
                            <i class="ri-check-line text-xs"></i>
                            已就绪
                          </span>
                        )}
                        {ep.transcriptStatus === "placeholder" && (
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-50 text-amber-700 border border-amber-200/60">
                            <i class="ri-time-line text-xs"></i>
                            待整理
                          </span>
                        )}
                        {ep.transcriptStatus === "missing" && (
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-mono text-[#2d2a26]/40 bg-zinc-100">
                            暂缺
                          </span>
                        )}
                      </td>
                      <td class="py-3 px-4 text-right font-mono font-bold text-orange-950 whitespace-nowrap">
                        <span class="play-count-badge">{ep.plays}</span>
                      </td>
                      <td class="py-3 px-4 text-center whitespace-nowrap">
                        <div class="inline-flex items-center gap-2">
                          <button
                            type="button"
                            class="simulate-play-btn text-[11px] text-orange-800 hover:text-orange-900 border border-orange-200 hover:bg-orange-50 px-2 py-0.5 rounded font-mono transition-colors"
                            data-id={ep.id}
                            title="测试上报播放数据"
                          >
                            +1 试听
                          </button>
                          <button
                            type="button"
                            class="delete-episode-btn text-[11px] text-red-700 hover:text-red-900 border border-red-200 hover:bg-red-50 px-2 py-0.5 rounded font-mono transition-colors"
                            data-id={ep.id}
                            data-title={ep.title}
                            title="从本地数据库中删除此单集"
                          >
                            删除
                          </button>
                          <a
                            href={`/episodes/${ep.id}`}
                            target="_blank"
                            class="text-[11px] text-[#2d2a26]/60 hover:text-orange-800 font-mono transition-colors"
                          >
                            <span>直达收听</span>
                          </a>
                        </div>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>

