      if (def) {
        if (aiFormUrl && (!aiFormUrl.value || aiFormUrl.value.includes("api."))) {
          aiFormUrl.value = def.url;
        }
        if (aiFormModel) {
          aiFormModel.value = def.model;
        }
      }
    });

    const aiConfigForm = document.getElementById("ai-config-form");
    const aiConfigFeedback = document.getElementById("ai-config-feedback");
    const btnSaveAiForm = document.getElementById("btn-save-ai-form");

    aiConfigForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!btnSaveAiForm) return;
      btnSaveAiForm.disabled = true;
      btnSaveAiForm.textContent = "正在保存并生效...";
      if (aiConfigFeedback) {
        aiConfigFeedback.className = "text-xs font-mono text-orange-800";
        aiConfigFeedback.textContent = "正在写入服务环境并热加载...";
      }

      const provider = aiFormProvider?.value || "deepseek";
      const rawKey = aiFormKey?.value?.trim() || "";
      const apiKey = rawKey.includes("••••") ? "" : rawKey;
      const apiUrl = aiFormUrl?.value?.trim() || "";
      const model = aiFormModel?.value?.trim() || "";

      try {
        const res = await fetch("/api/admin", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action: "save-ai-config",
            provider,
            apiKey,
            apiUrl,
            model,
          }),
        });
        const data = await res.json();
        if (data.success) {
          if (aiConfigFeedback) {
            aiConfigFeedback.className = "text-xs font-mono text-emerald-700";
            aiConfigFeedback.textContent = "保存成功！已安全应用到本地环境，正在刷新状态...";
          }
          setTimeout(() => window.location.reload(), 1000);
        } else {
          if (aiConfigFeedback) {
            aiConfigFeedback.className = "text-xs font-mono text-red-600";
            aiConfigFeedback.textContent = `保存失败: ${data.error || "未知异常"}`;
          }
          btnSaveAiForm.disabled = false;
          btnSaveAiForm.textContent = "保存并应用到环境变量";
        }
      } catch (err) {
        if (aiConfigFeedback) {
          aiConfigFeedback.className = "text-xs font-mono text-red-600";
          aiConfigFeedback.textContent = `请求异常: ${err.message}`;
        }
        btnSaveAiForm.disabled = false;
        btnSaveAiForm.textContent = "保存并应用到环境变量";
      }
    });

    const btnCopyCmdLocal = document.getElementById("btn-copy-cmd-local");
    const textCmdLocal = document.getElementById("text-cmd-local");
    btnCopyCmdLocal?.addEventListener("click", () => {
      if (textCmdLocal?.textContent) {
        navigator.clipboard.writeText(textCmdLocal.textContent.trim());
        const span = btnCopyCmdLocal.querySelector("span");
        if (span) span.textContent = "已复制 ✓";
        setTimeout(() => {
          if (span) span.textContent = "复制";
        }, 1500);
      }
    });
    let isTestingAi = false;
    async function testServerAi() {
      if (isTestingAi || !btnTestServerAi) return;
      isTestingAi = true;
      btnTestServerAi.disabled = true;
      btnTestServerAi.textContent = "正在握手测试...";
      if (serverAiFeedback) {
        serverAiFeedback.className = "text-xs font-mono text-orange-800 mt-2.5 pt-2.5 border-t border-[#2d2a26]/10 block";
        serverAiFeedback.textContent = "正在使用服务器当前环境变量发送轻量测试请求...";
      }

      try {
        const res = await fetch("/api/admin", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "test-ai" }),
        });
        const data = await res.json().catch(() => ({}));
        if (data.success) {
          const successMsg = `连通成功 (${data.duration}ms)`;
          if (serverAiFeedback) {
            serverAiFeedback.className = "text-xs font-mono text-emerald-700 mt-2.5 pt-2.5 border-t border-[#2d2a26]/10 block";
            serverAiFeedback.textContent = successMsg;
          }
          window.toast?.success(successMsg);
        } else {
          const errMsg = `测试失败: ${data.error || "未通过连通性验证"}`;
          if (serverAiFeedback) {
            serverAiFeedback.className = "text-xs font-mono text-red-600 mt-2.5 pt-2.5 border-t border-[#2d2a26]/10 block";
            serverAiFeedback.textContent = errMsg;
          }
          window.toast?.error(errMsg);
        }
      } catch (err) {
        const errTxt = `网络请求异常: ${err?.message || "请稍后重试"}`;
        if (serverAiFeedback) {
          serverAiFeedback.className = "text-xs font-mono text-red-600 mt-2.5 pt-2.5 border-t border-[#2d2a26]/10 block";
          serverAiFeedback.textContent = errTxt;
        }
        window.toast?.error(errTxt);
      } finally {
        isTestingAi = false;
        btnTestServerAi.disabled = false;
        btnTestServerAi.textContent = "测试连通性";
      }
    }

    window.__doTestServerAi = testServerAi;
    btnTestServerAi?.addEventListener("click", testServerAi);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAdminConsole);
  } else {
    initAdminConsole();
  }
  document.addEventListener("astro:page-load", initAdminConsole);
</script>

