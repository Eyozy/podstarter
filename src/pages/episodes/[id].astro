---
import MainLayout from "../../layouts/MainLayout.astro";
import { publishedEpisodes, formatEpisodeDate, extractEpisodeNumber } from "../../utils/episodes";
import { getEntry } from "astro:content";
import DOMPurify from "isomorphic-dompurify";
import { loadSiteConfig } from "../../../scripts/siteConfig.js";
const site = loadSiteConfig();


export async function getStaticPaths() {
  return publishedEpisodes.map((episode) => ({
    params: { id: episode.id },
    props: { episode },
  }));
}

const { episode } = Astro.props;
const formattedDate = formatEpisodeDate(episode.pubDate, {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const coverImage = episode.itunes?.image || site.assets.defaultCover;

const duration = episode.itunes?.duration || site.ui.unknownDurationLabel;
const episodeNumber = extractEpisodeNumber(episode, site.ui.episodeNumberFallbackLabel);
const episodeNumberLabel = `${site.ui.episodeNumberPrefix} ${episodeNumber}`;
const transcriptsEnabled = site.features?.transcripts === true;

let transcript;
let transcriptHtml = "";
let isTranscriptPlaceholder = false;
if (transcriptsEnabled) {
  const fs = await import("node:fs");
  const path = await import("node:path");
  const { marked } = await import("marked");
  const transcriptPath = path.join(process.cwd(), "src/content/transcripts", `${episode.id}.md`);
  if (fs.existsSync(transcriptPath)) {
    const raw = fs.readFileSync(transcriptPath, "utf-8");
    const cleanBody = raw.replace(/^---[\s\S]*?---\s*/, "");
    transcriptHtml = await marked.parse(cleanBody);
    isTranscriptPlaceholder = Boolean(raw.includes(site.transcripts?.placeholderNotice || ""));
    transcript = {
      id: episode.id,
      body: cleanBody,
      data: {},
    };
  }
}

const canShowTranscript = transcriptsEnabled;
const hasTranscriptContent = transcriptHtml !== "" && !isTranscriptPlaceholder;

const SANITIZE_OPTIONS = {
  ALLOWED_TAGS: [
    "p", "br", "strong", "em", "a", "ul", "ol", "li",
    "h2", "h3", "img", "figure", "figcaption", "blockquote",
  ],
  ALLOWED_ATTR: ["href", "src", "alt", "class"],
  ALLOW_DATA_ATTR: false,
};

const sanitizedContent = DOMPurify.sanitize(episode.content || "", SANITIZE_OPTIONS);
const sanitizedTranscript = DOMPurify.sanitize(transcriptHtml, SANITIZE_OPTIONS);
---

<MainLayout title={episode.title}>
  <article class="max-w-6xl mx-auto w-full" data-episode-page>
    <nav class="mb-6 sm:mb-8 md:mb-12 font-serif text-xs sm:text-sm opacity-50">
      <a href="/episodes" class="hover:text-orange-800 transition-colors"
        >{site.pages.episodeDetail.breadcrumbListLabel}</a
      >
      <span class="mx-2">/</span>
      <span class="text-[#2d2a26]">{site.pages.episodeDetail.breadcrumbCurrentLabel}</span>
    </nav>

    <header class="flex flex-col md:flex-row md:items-stretch gap-5 sm:gap-6 md:gap-8 lg:gap-12 mb-10 sm:mb-12 md:mb-20">
      <div
        class="hidden md:block w-60 lg:w-72 shrink-0 shadow-2xl border border-[#2d2a26]/5 overflow-hidden bg-[#f0ede8] rounded-2xl md:aspect-square self-start md:self-stretch"
        data-fit-cover
      >
        <img
          src={coverImage}
          alt={episode.title}
          class="size-full object-cover"
        />
      </div>

      <div
        class="md:hidden w-[clamp(132px,45vw,220px)] mx-auto shadow-lg border border-[#2d2a26]/5 overflow-hidden bg-[#f0ede8] rounded-2xl aspect-square"
      >
        <img
          src={coverImage}
          alt={episode.title}
          class="size-full object-cover"
        />
      </div>

      <div
        class="grow min-w-0 flex flex-col justify-between py-1"
        data-fit-content
      >
        <div>
          <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 mb-4">
            <span
              class="text-[10px] font-serif font-bold uppercase tracking-widest text-orange-700 bg-orange-50 px-3 py-1 rounded-md"
            >
              {episodeNumberLabel}
            </span>
            <time class="text-xs font-serif opacity-50">{formattedDate}</time>
          </div>

          <h1
            class="text-[1.75rem] sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-4 leading-tight tracking-tight"
            data-fit-title
            data-min-scale="0.55"
            data-min-font="16"
          >
            {episode.title}
          </h1>

          {
            episode.tags && episode.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-4">
                {episode.tags.map((tag) => (
                  <span
                    class="tag-item cursor-pointer text-xs px-3 py-1 bg-[#f5f2ed] border border-[#2d2a26]/10 text-[#2d2a26]/60 rounded-full font-serif hover:bg-orange-50 hover:border-orange-200 hover:text-orange-700 transition-colors"
                    data-tag={tag}
                  >
                    #{tag}
                  </span>
                ))}
              </div>
            )
          }
        </div>

        <div class="flex flex-col gap-4">
          <div
            class="flex flex-wrap items-center gap-x-8 gap-y-2 text-sm font-serif opacity-60"
          >
            <div class="flex items-center gap-2">
              <i class="ri-time-line text-sm sm:text-base"></i>
              {duration}
            </div>
            <div class="flex items-center gap-2">
              <i class="ri-music-2-line text-sm sm:text-base"></i>
              {episode.enclosure?.type?.split("/")[1]?.toUpperCase() || "MP3"}
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <button
            class="play-button flex items-center gap-2.5 px-5 sm:px-6 py-3 bg-[#2d2a26] text-white font-serif text-[11px] sm:text-xs font-bold uppercase tracking-[0.18em] hover:bg-orange-800 transition-all rounded-lg shadow-lg transform hover:-translate-y-0.5 active:translate-y-0"
              data-title={episode.title}
              data-audio={episode.enclosure?.url}
              data-cover={coverImage}
            >
              <i class="ri-play-fill text-xs sm:text-sm translate-x-0.5"></i>
              <span>{site.pages.episodeDetail.playNowLabel}</span>
            </button>

            {
              canShowTranscript && (
                <button
                  id="download-md"
                  class={`flex items-center gap-2.5 px-5 sm:px-6 py-3 border font-serif text-[11px] sm:text-xs font-bold uppercase tracking-[0.18em] transition-all rounded-lg shadow-sm ${
                    !hasTranscriptContent
                      ? "border-gray-200 text-gray-400 bg-gray-100/50 opacity-50 cursor-not-allowed pointer-events-none"
                      : "border-[#2d2a26]/10 text-[#2d2a26] hover:bg-[#2d2a26]/5 cursor-pointer"
                  }`}
                  title={
                    !hasTranscriptContent
                      ? "文字稿正在整理中，暂不可下载"
                      : site.pages.episodeDetail.downloadTranscriptTitle
                  }
                  disabled={!hasTranscriptContent}
                >
                  <i class="ri-download-2-line text-sm"></i>
                  <span>{site.pages.episodeDetail.downloadTranscriptLabel}</span>
                </button>
              )
            }
          </div>
        </div>
      </div>
    </header>

    <section
      class="prose prose-orange max-w-none prose-headings:font-serif prose-p:font-serif prose-p:leading-relaxed prose-p:text-[#2d2a26]/80 bg-white p-5 sm:p-6 md:p-10 lg:p-14 border border-[#2d2a26]/5 shadow-sm rounded-2xl"
    >
      <div
        class="flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-[#2d2a26]/10 mb-8 sm:mb-10 pb-4"
      >
        <button
          class="tab-btn active text-base sm:text-lg font-bold font-serif transition-colors text-orange-700 opacity-100"
          type="button"
          data-target="info"
        >
          {site.pages.episodeDetail.infoTabLabel}
        </button>
        {
          canShowTranscript && (
            <button
              class="tab-btn text-base sm:text-lg font-bold font-serif transition-all opacity-40 hover:opacity-100 hover:text-orange-700 cursor-pointer inline-flex items-center"
              type="button"
              data-target="transcript"
            >
              {site.pages.episodeDetail.transcriptTabLabel}
              {
                hasTranscriptContent ? (
                  <span class="ml-2 text-xs bg-orange-100 text-orange-800 px-2 py-0.5 rounded-full font-serif font-bold tracking-wider">
                    {site.pages.episodeDetail.transcriptNewBadgeLabel || "精校"}
                  </span>
                ) : (
                  <span class="ml-2 text-[10px] bg-stone-100 text-stone-600 px-1.5 py-0.5 rounded-full font-serif tracking-wider">
                    整理中
                  </span>
                )
              }
            </button>
          )
        }
      </div>

      <div
        id="panel-info"
        class="tab-panel transition-opacity duration-300 ease-in-out"
      >
        <div
          class="episode-content"
          id="episode-body"
          set:html={sanitizedContent}
        />
      </div>

      {
        canShowTranscript && (
          <div
            id="panel-transcript"
            class="tab-panel hidden opacity-0 transition-opacity duration-300 ease-in-out"
          >
            {hasTranscriptContent ? (
              <>
                {transcript?.data.contributors && (
                  <div class="mb-6 sm:mb-8 p-4 bg-[#f9f8f6] rounded-lg border border-[#2d2a26]/5">
                    <span class="text-xs font-bold uppercase tracking-widest opacity-50 block mb-2">
                      {site.pages.episodeDetail.transcriptContributorsLabel}
                    </span>
                    <div class="flex flex-wrap gap-2">
                      {transcript?.data.contributors.map((p: string) => (
                        <span class="text-sm font-serif bg-white px-3 py-1 rounded-md border border-[#2d2a26]/5 shadow-sm">
                          {p}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
                <div class="transcript-content">
                  <Fragment set:html={sanitizedTranscript} />
                </div>
              </>
            ) : (
              <div class="py-12 px-6 text-center bg-[#faf9f7] rounded-2xl border border-[#2d2a26]/10 my-4">
                <div class="w-12 h-12 mx-auto mb-3.5 rounded-full bg-orange-100 text-orange-800 flex items-center justify-center">
                  <i class="ri-file-text-line text-xl"></i>
                </div>
                <h3 class="text-base font-bold text-[#2d2a26] mb-1.5 font-serif">
                  {site.pages.episodeDetail.transcriptEmptyTitle || "文字稿整理中..."}
                </h3>
                <p class="text-xs text-[#2d2a26]/65 font-serif max-w-md mx-auto leading-relaxed">
                  {site.transcripts?.placeholderNotice || "暂未提供文字稿，待使用通义听悟/NotebookLM 转化后提供"}
                </p>
              </div>
            )}
          </div>
        )
      }
    </section>
  </article>
</MainLayout>

<script is:inline define:vars={{ episode, coverImage, formattedDate, downloadMetaDateLabel: site.pages.episodeDetail.downloadMetaDateLabel, downloadMetaAudioLabel: site.pages.episodeDetail.downloadMetaAudioLabel }}>
  function initTabs(pageRoot) {
    const tabs = pageRoot.querySelectorAll(".tab-btn");
    let isAnimating = false;
    const TRANSITION_MS = 300;

    const setActiveTab = (activeTab) => {
      tabs.forEach((t) => {
        t.classList.remove("active", "text-orange-700", "opacity-100");
        if (!t.hasAttribute("disabled")) {
          t.classList.add("opacity-40");
        }
      });
      activeTab.classList.remove("opacity-40");
      activeTab.classList.add("active", "text-orange-700", "opacity-100");
    };

    const swapPanels = (currentPanel, targetPanel) => {
      currentPanel.style.opacity = "0";
      setTimeout(() => {
        currentPanel.classList.add("hidden");

        targetPanel.classList.remove("hidden");
        void targetPanel.offsetWidth;

        targetPanel.style.opacity = "1";
        setTimeout(() => {
          isAnimating = false;
        }, TRANSITION_MS);
      }, TRANSITION_MS);
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        if (tab.disabled || isAnimating) return;
        if (tab.classList.contains("active")) return;

        const targetId = tab.dataset.target;
        const targetPanel = pageRoot.querySelector(
          `#panel-${targetId}`,
        );
        const currentPanel = pageRoot.querySelector(".tab-panel:not(.hidden)");

        if (!targetPanel || targetPanel === currentPanel) return;

        isAnimating = true;

        setActiveTab(tab);

        if (currentPanel) {
          swapPanels(currentPanel, targetPanel);
        } else {
          targetPanel.classList.remove("hidden");
          void targetPanel.offsetWidth;
          targetPanel.style.opacity = "1";
          isAnimating = false;
        }
      });
    });
  }

  function initTimestampLinks() {
    const contentAreas = document.querySelectorAll(
      ".episode-content, .transcript-content",
    );
    if (!contentAreas.length) return;

    const TIMESTAMP_PATTERN =
      /(?:\[)?(?:<a\b[^>]*>)?(?:\[)?(?<![\d:])(\d{1,2}:\d{2}(?::\d{2})?)(?![\d:])(?:\])?(?:<\/a>)?(?:\])?/g;
    const parseTimeToSeconds = (timeStr) => {
      const clean = timeStr.replace(/[^\d:]/g, "");
      const parts = clean.split(":").map(Number);
      if (parts.length === 3) {
        return parts[0] * 3600 + parts[1] * 60 + parts[2];
      } else if (parts.length === 2) {
        return parts[0] * 60 + parts[1];
      }
      return 0;
    };

    contentAreas.forEach((area) => {
      if (area.dataset.processed) return;

      const audioUrl = encodeURIComponent(episode.enclosure?.url || "");
      const coverUrl = encodeURIComponent(episode.itunes?.image || coverImage || "");
      const currentEpId = encodeURIComponent(episode.id || "");
      const content = area.innerHTML;
      const processedContent = content.replace(
        TIMESTAMP_PATTERN,
        (_fullMatch, time) => {
          const match = time;
          const seconds = parseTimeToSeconds(match);
          return `<button type="button" class="timestamp-link inline-flex items-center gap-1 text-orange-800 hover:text-orange-900 bg-orange-50 hover:bg-orange-100 px-1.5 py-0.5 rounded font-mono text-xs font-semibold mx-1 cursor-pointer transition-colors" data-seconds="${seconds}" data-audio="${audioUrl}" data-cover="${coverUrl}" data-episode-id="${currentEpId}">▶ ${match}</button>`;
        },
      );
      area.innerHTML = processedContent;
      area.dataset.processed = "true";
    });
  }

  window.detectAndWrapTimestamps = initTimestampLinks;

  if (!window.__timestampListenerBound) {
    window.__timestampListenerBound = true;
    document.addEventListener("click", (e) => {
      const target = e.target.closest(".timestamp-link");
      if (!target) return;
      const seconds = Number(target.dataset.seconds);
      if (!Number.isFinite(seconds)) return;
      const audioUrl = decodeURIComponent(target.dataset.audio || "");
      if (!audioUrl) return;
      const cover = decodeURIComponent(target.dataset.cover || "");
      const episodeId = decodeURIComponent(target.dataset.episodeId || "");

      if (typeof window.seekToTimestamp === "function") {
        window.seekToTimestamp(seconds, audioUrl, episodeId, cover);
      }
    });
  }

  function initDownload() {
    const downloadBtn = document.getElementById("download-md");
    if (!downloadBtn || !window.episodeData?.transcript) return;

    const buildMarkdown = () => {
      const { episode, formattedDate, transcript } = window.episodeData;
      let mdContent = `# ${episode.title}\n\n`;
      mdContent += `> **${downloadMetaDateLabel}**: ${formattedDate}\n`;
      mdContent += `> **${downloadMetaAudioLabel}**: ${episode.enclosure?.url}\n\n`;
      mdContent += `---\n\n`;
      mdContent += transcript.body;
      return mdContent;
    };

    downloadBtn.addEventListener("click", (e) => {
      if (downloadBtn.hasAttribute("disabled")) {
        e.preventDefault();
        return;
      }
      const blob = new Blob([buildMarkdown()], { type: "text/markdown" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `${episode.title}.md`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  }

  function fitEpisodeTitle() {
    const title = document.querySelector("[data-fit-title]");
    const content = document.querySelector("[data-fit-content]");
    const cover = document.querySelector("[data-fit-cover]");
    if (!title || !content) return;

    title.style.removeProperty("font-size");

    if (!cover || cover.offsetParent === null) return;

    let computed = window.getComputedStyle(title);
    let fontSize = parseFloat(computed.fontSize);
    const minScale = parseFloat(title.dataset.minScale || "0.75");
    const minFont = parseFloat(title.dataset.minFont || "16");
    const minFontSize = Math.max(fontSize * minScale, minFont);

    const fits = () => content.scrollHeight <= content.clientHeight + 1;

    while (!fits() && fontSize > minFontSize) {
      fontSize -= 1;
      title.style.fontSize = `${fontSize}px`;
      computed = window.getComputedStyle(title);
    }
  }

  let resizeTimer;
  function handleTitleResize() {
    if (resizeTimer) window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      fitEpisodeTitle();
    }, 120);
  }

  function initTitleFit() {
    fitEpisodeTitle();
    if ("fonts" in document && document.fonts && document.fonts.ready) {
      document.fonts.ready
        .then(() => {
          fitEpisodeTitle();
        })
        .catch(() => {});
    }
    window.removeEventListener("resize", handleTitleResize);
    window.addEventListener("resize", handleTitleResize, { passive: true });
  }

  function initEpisodePage() {
    const pageRoot = document.querySelector("[data-episode-page]");
    if (!pageRoot || pageRoot.dataset.bound === "true") return;
    pageRoot.dataset.bound = "true";

    initTabs(pageRoot);
    initDownload();
    initTimestampLinks();
    initTitleFit();
  }

  const scheduleInit = () => {
    requestAnimationFrame(() => initEpisodePage());
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", scheduleInit);
  } else {
    scheduleInit();
  }

  document.addEventListener("astro:page-load", scheduleInit);

  document.addEventListener("astro:before-swap", () => {
    window.removeEventListener("resize", handleTitleResize);
  });
</script>

<style is:global>
  .episode-content,
  .transcript-content {
    overflow-wrap: anywhere;
  }
  .episode-content pre,
  .transcript-content pre {
    overflow-x: auto;
  }
  .episode-content h2,
  .transcript-content h2 {
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    font-weight: bold;
    color: #2d2a26;
  }
  .episode-content p,
  .transcript-content p {
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }
  .episode-content a,
  .transcript-content a {
    color: #c2410c;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 500;
  }
  .episode-content figure,
  .transcript-content figure {
    margin: 2.5rem 0;
  }
  .episode-content img,
  .transcript-content img {
    border-radius: 12px;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
    max-width: 100%;
    height: auto;
  }
  .episode-content ul,
  .transcript-content ul,
  .episode-content ol,
  .transcript-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .episode-content li,
  .transcript-content li {
    margin-bottom: 0.5rem;
  }
  .timestamp-link {
    border: 0;
    text-decoration: none !important;
  }
  .timestamp-link:focus-visible {
    outline: 2px solid #c2410c;
    outline-offset: 2px;
  }

  /* Transcript specific styles */
  .transcript-content strong {
    color: #7c2d12;
    font-weight: 700;
    background: #fff7ed;
    padding: 0 4px;
    border-radius: 4px;
    margin-right: 4px;
  }

  .transcript-content blockquote {
    font-style: italic;
    color: #78716c;
    border-left: 3px solid #e7e5e4;
    padding-left: 1rem;
    margin: 1.5rem 0;
  }
</style>

<script is:inline define:vars={{ episode, formattedDate, transcript, transcriptsEnabled }}>
  window.episodeData = {
    episode,
    formattedDate,
    transcript: transcriptsEnabled ? transcript : null,
  };
</script>
