---
import { loadSiteConfig } from "../../scripts/siteConfig.js";
const site = loadSiteConfig();
---

<div
  id="share-modal"
  class="fixed inset-0 z-100 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 p-2 sm:p-4 md:p-6"
  aria-hidden="true"
  hidden
  data-download-label={site.shareCard.downloadLabel}
  data-generating-label={site.shareCard.generatingLabel}
  data-error-message={site.shareCard.generateErrorMessage}
  data-filename-prefix={site.shareCard.filenamePrefix}
>
  <div
    class="absolute inset-0 bg-[#2d2a26]/80 backdrop-blur-sm"
    id="share-modal-overlay"
  >
  </div>

  <div
    class="relative bg-[#f5f2ed] p-2 sm:p-4 md:p-6 max-w-3xl w-full shadow-2xl rounded-2xl border border-[#2d2a26]/10 transform scale-95 transition-transform duration-300 max-h-[90vh] flex flex-col"
    id="share-modal-content"
    role="dialog"
    aria-modal="true"
    aria-labelledby="share-modal-title"
    aria-describedby="share-card-snippet"
    tabindex="-1"
  >
    <div class="flex justify-between items-center mb-3 sm:mb-5 shrink-0">
      <h3 id="share-modal-title" class="text-base sm:text-lg font-bold font-serif">
        {site.shareCard.title}
      </h3>
      <button
        id="close-share-modal"
        class="opacity-40 hover:opacity-100 transition-opacity p-1"
        aria-label={site.ui.closeLabel}
      >
        <i class="ri-close-line text-xl"></i>
      </button>
    </div>

    <div
      id="share-card-scroll-container"
      class="overflow-y-auto overflow-x-hidden min-h-0 mb-2 sm:mb-5 flex justify-center items-start w-full"
      style="scrollbar-gutter: stable;"
    >
      <div
        id="share-card-scale-wrapper"
        class="origin-top transition-transform duration-200 shrink-0"
        style="--card-scale: 0.9; transform: scale(var(--card-scale));"
      >
        <div
          id="share-card-container"
          class="bg-white px-6 py-6 sm:px-8 sm:py-7 w-150 flex flex-col gap-5 sm:gap-6 relative rounded-2xl overflow-hidden"
        >
          <div class="flex gap-4 sm:gap-6 items-start">
            <div class="size-20 sm:size-24 shrink-0 overflow-hidden shadow-lg border border-black/5 bg-[#f0ede8] rounded-lg">
              <img
                id="share-card-cover"
                src=""
                alt="Cover"
                class="w-full h-full object-cover"
              />
            </div>

            <div class="grow flex flex-col justify-center min-h-20 sm:min-h-24 min-w-0">
              <div
                class="text-[#3498db] font-serif font-bold text-base tracking-widest mb-2"
              >
                {site.brand.name}
              </div>
              <h2
                id="share-card-title"
                class="text-base sm:text-lg font-serif font-bold leading-snug text-[#2d2a26] tracking-tight line-clamp-3"
              >
              </h2>
            </div>

            <div class="shrink-0 flex flex-col items-center gap-1.5">
              <div id="share-card-qrcode" class="size-20 flex items-center justify-center"></div>
              <div class="text-[10px] text-gray-400 font-serif tracking-widest text-center">
                {site.shareCard.qrLabel}
              </div>
            </div>
          </div>

          <div class="relative">
            <p id="share-card-snippet" class="text-sm sm:text-base font-serif text-gray-500 leading-relaxed text-justify line-clamp-3">
            </p>
          </div>

          <div
            class="border-t border-gray-200 pt-4 flex justify-between items-center text-gray-400 font-serif"
          >
            <div class="flex items-center gap-2 text-base text-gray-500">
              <i class="ri-time-line text-sm"></i>
              <span id="share-card-duration">00:00:00</span>
            </div>
            <div class="text-xs sm:text-sm tracking-[0.18em] uppercase text-gray-400 text-right">
              EST. {site.brand.establishedYear} {site.brand.name}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flex gap-4">
      <button
        id="download-card-btn"
        class="grow py-3 sm:py-4 bg-[#2d2a26] text-white text-xs font-bold uppercase tracking-widest hover:bg-orange-800 transition-all rounded-xl shadow-md flex items-center justify-center gap-2"
      >
        <i class="ri-download-2-line text-sm sm:text-base"></i>
        {site.shareCard.downloadLabel}
      </button>
    </div>
  </div>
</div>

<script>
  import QRCode from "qrcode";

  type ShareModalPayload = {
    title: string;
    cover: string;
    snippet: string;
    url: string;
    duration: string;
    episodeId: string;
    link?: string;
    xiaoyuzhouLink?: string;
  };

  type ShareModalWindow = Window & {
    __openShareModal?: (payload: ShareModalPayload) => void;
    __shareModalClickBound?: boolean;
    __shareModalResizeBound?: boolean;
  };

  function initShareModal() {
    const SNIPPET_LIMIT = 150;
    const SCALE_PADDING = 8;
    const modal = document.getElementById("share-modal");
    const content = document.getElementById("share-modal-content");

    if (!(modal instanceof HTMLDivElement) || !(content instanceof HTMLDivElement)) {
      return;
    }
    const modalEl = modal;
    const contentEl = content;
    if (modalEl.dataset.bound === "true") return;
    modalEl.dataset.bound = "true";

    const overlay = document.getElementById("share-modal-overlay");
    const closeBtn = document.getElementById("close-share-modal");
    if (!(closeBtn instanceof HTMLButtonElement)) {
      return;
    }

    const cardTitle = document.getElementById("share-card-title");
    const cardCover = document.getElementById(
      "share-card-cover",
    );
    const cardSnippet = document.getElementById("share-card-snippet");
    const qrcodeContainer = document.getElementById("share-card-qrcode");
    const scaleWrapper = document.getElementById("share-card-scale-wrapper");
    const cardContainer = document.getElementById("share-card-container");
    const cardDuration = document.getElementById("share-card-duration");
    const scrollContainer = document.getElementById("share-card-scroll-container");
    let resizeObserver: ResizeObserver | null = null;
    let lastActiveElement: HTMLElement | null = null;
    let isUpdatingScale = false;
    let stableScrollbarWidth = 0;
    let lastAvailableWidth = 0;
    let lastCardHeight = 0;
    let lastScaleValue = "";

    function truncateText(text: string, maxLength: number) {
      if (!text) return "";
      if (text.length <= maxLength) return text;
      return text.substring(0, maxLength).trim() + "……";
    }

    const handleKeydown = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        closeModal();
        return;
      }
      if (e.key !== "Tab") return;

      const focusable = Array.from(
        contentEl.querySelectorAll(
          "button,[href],input,select,textarea,[tabindex]:not([tabindex='-1'])",
        ),
      ).filter((el): el is HTMLElement => el instanceof HTMLElement && !el.hasAttribute("disabled"));

      if (!focusable.length) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };

    function setInteractiveState(root: HTMLElement, enabled: boolean) {
      if (!(root instanceof HTMLElement)) return;
      const interactive = root.querySelectorAll(
        "button, a[href], input, select, textarea, [tabindex]",
      );

      interactive.forEach((el) => {
        if (!(el instanceof HTMLElement)) return;

        if (!enabled) {
          if (!el.hasAttribute("data-prev-tabindex")) {
            const prevTabIndex = el.getAttribute("tabindex");
            if (prevTabIndex !== null) {
              el.setAttribute("data-prev-tabindex", prevTabIndex);
            }
          }
          el.setAttribute("tabindex", "-1");
        } else {
          const prevTabIndex = el.getAttribute("data-prev-tabindex");
          if (prevTabIndex !== null) {
            el.setAttribute("tabindex", prevTabIndex);
            el.removeAttribute("data-prev-tabindex");
          } else if (el.getAttribute("tabindex") === "-1") {
            el.removeAttribute("tabindex");
          }
        }
      });
    }

    function setModalOpen(isOpen: boolean) {
      if (isOpen) {
        modalEl.hidden = false;
      }
      modalEl.classList.toggle("opacity-0", !isOpen);
      modalEl.classList.toggle("pointer-events-none", !isOpen);
      contentEl.classList.toggle("scale-95", !isOpen);
      modalEl.setAttribute("aria-hidden", String(!isOpen));
      modalEl.toggleAttribute("inert", !isOpen);
      setInteractiveState(contentEl, isOpen);
      document.body.style.overflow = isOpen ? "hidden" : "";

      if (isOpen) {
        lastActiveElement =
          document.activeElement instanceof HTMLElement
            ? document.activeElement
            : null;
        requestAnimationFrame(() => closeBtn?.focus());
        document.addEventListener("keydown", handleKeydown);
      } else {
        document.removeEventListener("keydown", handleKeydown);
        lastActiveElement?.focus();
        window.setTimeout(() => {
          modalEl.hidden = true;
        }, 300);
      }
    }

    function buildEpisodeUrl(data: ShareModalPayload): string {
      const link = (data.link || data.xiaoyuzhouLink || "").trim();
      const id = (data.episodeId || "").trim();
      if (/^https?:\/\//i.test(link)) {
        if (id.startsWith("netease-") && link.includes("xiaoyuzhoufm.com")) {
          const neteaseId = id.replace(/^netease-/, "");
          return `https://music.163.com/program?id=${neteaseId}`;
        }
        if ((id.startsWith("xm-") || id.startsWith("ximalaya-")) && link.includes("xiaoyuzhoufm.com")) {
          const xmId = id.replace(/^(?:xm-|ximalaya-)/, "");
          return `https://www.ximalaya.com/sound/${xmId}`;
        }
        return link;
      }
      const neteaseMatch = id.match(/^netease-(\d+)/) || link.match(/netease-(\d+)/) || link.match(/[?&]id=(\d+)/);
      if (neteaseMatch) {
        return `https://music.163.com/program?id=${neteaseMatch[1]}`;
      }

      const xmMatch = id.match(/^(?:xm-|ximalaya-)(\d+)/) || link.match(/sound\/(\d+)/);
      if (xmMatch) {
        return `https://www.ximalaya.com/sound/${xmMatch[1]}`;
      }

      const xyzMatch = id.match(/^xyz-([a-zA-Z0-9]+)/) || link.match(/\/episode\/([a-zA-Z0-9]+)/);
      if (xyzMatch) {
        return `https://www.xiaoyuzhoufm.com/episode/${xyzMatch[1]}`;
      }
      if (/^[a-f0-9]{24}$/i.test(id)) {
        return `https://www.xiaoyuzhoufm.com/episode/${id}`;
      }
      const origin = typeof window !== "undefined" && window.location?.origin
        ? window.location.origin
        : "";
      const path = link.startsWith("/") ? link : `/episodes/${id}`;
      return origin ? `${origin}${path}` : path;
    }

    async function openModal(data: ShareModalPayload) {
      if (cardTitle instanceof HTMLElement) cardTitle.textContent = data.title;
      if (cardSnippet)
        cardSnippet.textContent = truncateText(data.snippet, SNIPPET_LIMIT);
      if (cardCover instanceof HTMLImageElement && data.cover)
        cardCover.src = data.cover;
      if (cardDuration instanceof HTMLElement && data.duration)
        cardDuration.textContent = data.duration;

      setModalOpen(true);
      if (qrcodeContainer) {
        qrcodeContainer.innerHTML = "";
      }

      const episodeUrl = buildEpisodeUrl(data);

      try {
        if (qrcodeContainer) {
          const canvas = document.createElement("canvas");
          await QRCode.toCanvas(canvas, episodeUrl, {
            width: 80,
            margin: 2,
            color: {
              dark: "#2d2a26",
              light: "#ffffff",
            },
          });
          qrcodeContainer.appendChild(canvas);
        }
      } catch (error) {
        console.error("Failed to render QR code", error);
      }

      if (cardCover instanceof HTMLImageElement) {
        cardCover.onload = () => updateCardScale();
      }
      if (!resizeObserver && typeof ResizeObserver !== "undefined") {
        resizeObserver = new ResizeObserver(() => {
          if (!isUpdatingScale) updateCardScale();
        });
        if (scrollContainer) {
          resizeObserver.observe(scrollContainer);
        }
      }
      requestAnimationFrame(updateCardScale);
      setTimeout(updateCardScale, 80);
    }

    const shareWindow = window as ShareModalWindow;
    shareWindow.__openShareModal = (payload) => {
      void openModal(payload);
    };

    function closeModal() {
      setModalOpen(false);
      if (resizeObserver) {
        resizeObserver.disconnect();
        resizeObserver = null;
      }
    }

    function updateCardScale() {
      if (!scaleWrapper || !cardContainer || !scrollContainer) return;
      if (isUpdatingScale) return;
      isUpdatingScale = true;

      const totalWidth = scrollContainer.offsetWidth;
      const scrollbarWidth = totalWidth - scrollContainer.clientWidth;
      stableScrollbarWidth = Math.max(stableScrollbarWidth, scrollbarWidth);
      const availableWidth = totalWidth - stableScrollbarWidth;
      const cardWidth = cardContainer.offsetWidth;
      const cardHeight = cardContainer.offsetHeight;
      if (!availableWidth || !cardWidth || !cardHeight) {
        isUpdatingScale = false;
        return;
      }

      const widthUnchanged = Math.abs(availableWidth - lastAvailableWidth) < 1;
      const heightUnchanged = Math.abs(cardHeight - lastCardHeight) < 1;
      if (widthUnchanged && heightUnchanged) {
        isUpdatingScale = false;
        return;
      }

      const heightChanged = !heightUnchanged;
      lastAvailableWidth = availableWidth;
      lastCardHeight = cardHeight;

      const widthScale = Math.max(0, availableWidth - SCALE_PADDING) / cardWidth;
      const scale = Math.min(1, widthScale);
      const scaleValue = scale.toFixed(3);
      const scaledHeight = Math.ceil(cardHeight * scale);

      if (scaleValue === lastScaleValue && !heightChanged) {
        isUpdatingScale = false;
        return;
      }
      lastScaleValue = scaleValue;

      scaleWrapper.style.setProperty("--card-scale", scaleValue);
      scaleWrapper.style.transform = `scale(${scaleValue})`;
      scaleWrapper.style.width = `${cardWidth}px`;
      scaleWrapper.style.height = `${cardHeight}px`;
      const extraHeight = cardHeight - scaledHeight;
      scaleWrapper.style.marginBottom = extraHeight > 0 ? `-${extraHeight}px` : "0px";

      isUpdatingScale = false;
    }

    closeBtn?.addEventListener("click", closeModal);
    overlay?.addEventListener("click", closeModal);
  }

  const scheduleShareInit = () => {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initShareModal);
    } else {
      initShareModal();
    }
  };

  scheduleShareInit();
  document.addEventListener("astro:page-load", initShareModal);

  const shareWindow = window as ShareModalWindow;

  if (!shareWindow.__shareModalResizeBound) {
    shareWindow.__shareModalResizeBound = true;
    window.addEventListener(
      "resize",
      () => {
        const modal = document.getElementById("share-modal");
        if (!modal || modal.classList.contains("opacity-0")) return;
        const scaleWrapper = document.getElementById("share-card-scale-wrapper");
        const cardContainer = document.getElementById("share-card-container");
        const scrollContainer = document.getElementById("share-card-scroll-container");
        if (!scaleWrapper || !cardContainer || !scrollContainer) return;

        const totalWidth = scrollContainer.offsetWidth;
        const cardWidth = cardContainer.offsetWidth;
        const cardHeight = cardContainer.offsetHeight;
        if (!totalWidth || !cardWidth || !cardHeight) return;

        const widthScale = Math.max(0, totalWidth - 8) / cardWidth;
        const scale = Math.min(1, widthScale);
        const scaleValue = scale.toFixed(3);
        const scaledHeight = Math.ceil(cardHeight * scale);
        const extraHeight = cardHeight - scaledHeight;

        scaleWrapper.style.setProperty("--card-scale", scaleValue);
        scaleWrapper.style.transform = `scale(${scaleValue})`;
        scaleWrapper.style.width = `${cardWidth}px`;
        scaleWrapper.style.height = `${cardHeight}px`;
        scaleWrapper.style.marginBottom = extraHeight > 0 ? `-${extraHeight}px` : "0px";
      },
      { passive: true },
    );
  }

  if (!shareWindow.__shareModalClickBound) {
    shareWindow.__shareModalClickBound = true;
    document.addEventListener("click", (e: MouseEvent) => {
      const target = e.target;
      const btn = target instanceof Element ? target.closest(".share-button") : null;
      if (!btn) return;

      const payload: ShareModalPayload = {
        title: btn.getAttribute("data-title") || "",
        cover: btn.getAttribute("data-cover") || "",
        snippet: btn.getAttribute("data-snippet") || "",
        url: btn.getAttribute("data-audio") || "",
        duration: btn.getAttribute("data-duration") || "00:00:00",
        episodeId: btn.getAttribute("data-id") || "",
        link: btn.getAttribute("data-link") || "",
        xiaoyuzhouLink: btn.getAttribute("data-link") || "",
      };
      if (typeof shareWindow.__openShareModal !== "function") {
        initShareModal();
      }
      shareWindow.__openShareModal?.(payload);
    });
  }
</script>

<script>
  import { snapdom } from "@zumer/snapdom";

  type ShareModalDownloadWindow = Window & {
    __shareModalDownloadBound?: boolean;
  };

  function initShareModalDownload() {
    const modal = document.getElementById("share-modal");
    const downloadBtn = document.getElementById("download-card-btn");
    const cardContainer = document.getElementById("share-card-container");
    const cardTitle = document.getElementById("share-card-title");
    if (
      !(modal instanceof HTMLDivElement) ||
      !(downloadBtn instanceof HTMLButtonElement) ||
      !(cardContainer instanceof HTMLDivElement)
    ) {
      return;
    }

    const downloadWindow = window as ShareModalDownloadWindow;
    if (downloadWindow.__shareModalDownloadBound) return;
    downloadWindow.__shareModalDownloadBound = true;

    const shareDownloadLabel = modal.dataset.downloadLabel || "下载图片分享";
    const shareGeneratingLabel = modal.dataset.generatingLabel || "正在生成...";
    const shareErrorMessage = modal.dataset.errorMessage || "生成失败，请重试";
    const shareFilenamePrefix = modal.dataset.filenamePrefix || "share";

    downloadBtn.addEventListener("click", async () => {
      try {
        downloadBtn.textContent = shareGeneratingLabel;
        downloadBtn.disabled = true;
        cardContainer.classList.remove("rounded-2xl", "overflow-hidden");

        const safeTitle = cardTitle?.textContent?.substring(0, 10) || "";
        const filename = safeTitle
          ? `${shareFilenamePrefix}-${safeTitle}`
          : shareFilenamePrefix;

        await snapdom.download(cardContainer, {
          filename,
          scale: 3,
        });
      } catch (error: unknown) {
        console.error("Failed to generate image", error);
        window.toast?.error(shareErrorMessage);
      } finally {
        cardContainer.classList.add("rounded-2xl", "overflow-hidden");
        downloadBtn.innerHTML = `
          <i class="ri-download-2-line text-sm sm:text-base mr-1.5"></i>
          ${shareDownloadLabel}
        `;
        downloadBtn.disabled = false;
      }
    });
  }

  const scheduleShareModalDownload = () => {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initShareModalDownload, {
        once: true,
      });
      return;
    }
    initShareModalDownload();
  };

  scheduleShareModalDownload();
  document.addEventListener("astro:page-load", initShareModalDownload);
</script>
