{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Podcast Site Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "showcase",
            "podcast"
          ],
          "default": "showcase"
        }
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "showcase",
        "podcast"
      ],
      "default": "showcase"
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "description": "功能开关配置",
      "properties": {
        "aiTagging": {
          "type": "boolean",
          "default": false,
          "description": "是否启用 AI 标签/主题功能。启用后需配置环境变量中的 AI 提供商。"
        },
        "transcripts": {
          "type": "boolean",
          "default": false,
          "description": "是否启用文字稿功能。启用后会生成文字稿模板，并在前台展示文字稿相关入口。"
        },
        "themes": {
          "type": "boolean",
          "default": false,
          "description": "是否启用主题分类功能。开启后可在前台展示探索主题页。"
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "establishedYear": {
          "type": "integer"
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "keywords": {
              "type": "string"
            },
            "author": {
              "type": "string"
            },
            "twitter": {
              "type": "string"
            },
            "ogDescription": {
              "type": "string"
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultCover": {
          "type": "string"
        },
        "ogImage": {
          "type": "string"
        },
        "favicon": {
          "type": "string"
        }
      }
    },
    "podcast": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rssUrl": {
          "type": "string"
        },
        "appleUrl": {
          "type": "string"
        },
        "xiaoyuzhouUrl": {
          "type": "string"
        },
        "xiaoyuzhouQr": {
          "type": "string"
        },
        "wechatQr": {
          "type": "string"
        },
        "spotifyUrl": {
          "type": "string"
        },
        "ximalayaUrl": {
          "type": "string"
        },
        "neteaseUrl": {
          "type": "string"
        }
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "href": {
            "type": "string"
          }
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "titlePrefix": {
          "type": "string"
        },
        "titleHighlight": {
          "type": "string"
        },
        "titleSuffix": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "cta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "listenLatestLabel": {
              "type": "string"
            },
            "browseAllDesktopLabel": {
              "type": "string"
            },
            "browseAllMobileLabel": {
              "type": "string"
            },
            "learnMoreLabel": {
              "type": "string"
            }
          }
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recentSubtitle": {
          "type": "string",
          "description": "首页近期更新区块的英文副标题（如 Recent）"
        },
        "recentTitle": {
          "type": "string"
        },
        "recentBrowseAllLabel": {
          "type": "string"
        },
        "themesTitle": {
          "type": "string"
        },
        "rssTitle": {
          "type": "string"
        },
        "rssDescription": {
          "type": "string"
        },
        "rssLabels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "apple": {
              "type": "string"
            },
            "rss": {
              "type": "string"
            },
            "xiaoyuzhou": {
              "type": "string"
            },
            "wechat": {
              "type": "string"
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openMenuLabel": {
          "type": "string"
        },
        "closeMenuLabel": {
          "type": "string"
        },
        "backToTopLabel": {
          "type": "string"
        },
        "playLabel": {
          "type": "string"
        },
        "pauseLabel": {
          "type": "string"
        },
        "playEpisodeAriaLabel": {
          "type": "string"
        },
        "playLatestAriaLabel": {
          "type": "string"
        },
        "downloadLabel": {
          "type": "string"
        },
        "shareLabel": {
          "type": "string"
        },
        "detailLabel": {
          "type": "string"
        },
        "closeLabel": {
          "type": "string"
        },
        "unknownDurationLabel": {
          "type": "string"
        },
        "unknownSizeLabel": {
          "type": "string"
        },
        "episodeNumberPrefix": {
          "type": "string"
        },
        "episodeNumberFallbackLabel": {
          "type": "string"
        }
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            }
          }
        },
        "episodes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "activeThemeLabel": {
              "type": "string"
            },
            "clearThemeTitle": {
              "type": "string"
            },
            "searchLabel": {
              "type": "string"
            },
            "searchPlaceholder": {
              "type": "string"
            },
            "searchClearTitle": {
              "type": "string"
            },
            "searchCountPrefix": {
              "type": "string"
            },
            "searchCountSuffix": {
              "type": "string"
            },
            "yearFilterTitle": {
              "type": "string"
            },
            "allYearsLabel": {
              "type": "string"
            },
            "tagFilterTitle": {
              "type": "string"
            },
            "clearTagLabel": {
              "type": "string"
            },
            "toggleTagsExpandLabel": {
              "type": "string"
            },
            "toggleTagsCollapseLabel": {
              "type": "string"
            },
            "emptyTitle": {
              "type": "string"
            },
            "emptySubtitle": {
              "type": "string"
            }
          }
        },
        "themes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "emptyLabel": {
              "type": "string"
            }
          }
        },
        "about": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            }
          }
        },
        "episodeDetail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "breadcrumbListLabel": {
              "type": "string"
            },
            "breadcrumbCurrentLabel": {
              "type": "string"
            },
            "playNowLabel": {
              "type": "string"
            },
            "downloadTranscriptTitle": {
              "type": "string"
            },
            "downloadTranscriptLabel": {
              "type": "string"
            },
            "downloadMetaDateLabel": {
              "type": "string"
            },
            "downloadMetaAudioLabel": {
              "type": "string"
            },
            "infoTabLabel": {
              "type": "string"
            },
            "transcriptTabLabel": {
              "type": "string"
            },
            "transcriptEmptyTitle": {
              "type": "string"
            },
            "transcriptContributorsLabel": {
              "type": "string"
            },
            "transcriptNewBadgeLabel": {
              "type": "string"
            }
          }
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "membersTitle": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "avatar": {
                "type": "string"
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          }
        },
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "formUrl": {
              "type": "string"
            },
            "formButtonText": {
              "type": "string"
            },
            "channels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "descriptionLine1": {
          "type": "string"
        },
        "descriptionLine2": {
          "type": "string"
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notPlayingLabel": {
          "type": "string"
        },
        "nowPlayingLabel": {
          "type": "string"
        },
        "expandLabel": {
          "type": "string"
        },
        "minimizeLabel": {
          "type": "string"
        },
        "minimizeAriaLabel": {
          "type": "string"
        },
        "closeLabel": {
          "type": "string"
        },
        "closeAriaLabel": {
          "type": "string"
        },
        "prevLabel": {
          "type": "string"
        },
        "nextLabel": {
          "type": "string"
        },
        "backwardLabel": {
          "type": "string"
        },
        "forwardLabel": {
          "type": "string"
        },
        "playAriaLabel": {
          "type": "string"
        },
        "pauseAriaLabel": {
          "type": "string"
        }
      }
    },
    "shareCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "downloadLabel": {
          "type": "string"
        },
        "qrLabel": {
          "type": "string"
        },
        "generatingLabel": {
          "type": "string"
        },
        "generateErrorMessage": {
          "type": "string"
        },
        "filenamePrefix": {
          "type": "string"
        }
      }
    },
    "transcripts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "placeholderNotice": {
          "type": "string"
        }
      }
    }
  }
}
